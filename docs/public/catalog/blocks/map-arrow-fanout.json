ft luminous bloom (film-like) for divide + arrows -->\n              <filter id=\"maf-soft-glow\" x=\"-120%\" y=\"-120%\" width=\"340%\" height=\"340%\" color-interpolation-filters=\"sRGB\">\n                <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"3\" result=\"core\" />\n                <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"9\" result=\"mid\" />\n                <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"20\" result=\"halo\" />\n                <feMerge>\n                  <feMergeNode in=\"halo\" />\n                  <feMergeNode in=\"mid\" />\n                  <feMergeNode in=\"core\" />\n                  <feMergeNode in=\"SourceGraphic\" />\n                </feMerge>\n              </filter>\n              <filter id=\"maf-divide-glow\" x=\"-80%\" y=\"-40%\" width=\"260%\" height=\"180%\" color-interpolation-filters=\"sRGB\">\n                <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"3.5\" result=\"core\" />\n                <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"11\" result=\"mid\" />\n                <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"22\" result=\"halo\" />\n                <feMerge>\n                  <feMergeNode in=\"halo\" />\n                  <feMergeNode in=\"mid\" />\n                  <feMergeNode in=\"core\" />\n                  <feMergeNode in=\"SourceGraphic\" />\n                </feMerge>\n              </filter>\n              <!-- Anisotropic horizontal bloom for W→E fan-out glow trails -->\n              <filter id=\"maf-trail-glow\" x=\"-120%\" y=\"-280%\" width=\"340%\" height=\"660%\" color-interpolation-filters=\"sRGB\">\n                <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"42 6\" result=\"streak\" />\n                <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"18 4\" result=\"mid\" />\n                <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"7 2.5\" result=\"core\" />\n                <feMerge>\n                  <feMergeNode in=\"streak\" />\n                  <feMergeNode in=\"streak\" />\n                  <feMergeNode in=\"mid\" />\n                  <feMergeNode in=\"core\" />\n                </feMerge>\n              </filter>\n              <clipPath id=\"maf-circle-clip\">\n                <circle cx=\"960\" cy=\"540\" r=\"460\" />\n              </clipPath>\n              <radialGradient id=\"maf-circle-fill\" gradientUnits=\"userSpaceOnUse\" cx=\"960\" cy=\"540\" r=\"470\">\n                <stop offset=\"0%\" stop-color=\"#7a3838\" />\n                <stop offset=\"55%\" stop-color=\"#703030\" />\n                <stop offset=\"100%\" stop-color=\"#5a2828\" />\n              </radialGradient>\n            </defs>\n            <rect width=\"1920\" height=\"1080\" fill=\"var(--maf-outer-tan)\" />\n            <circle cx=\"960\" cy=\"540\" r=\"470\" fill=\"url(#maf-circle-fill)\" />\n            <g clip-path=\"url(#maf-circle-clip)\">\n              <!-- Berlin city silhouette approx (irregular) -->\n              <!-- Soviet East -->\n              <path id=\"maf-su\" fill=\"url(#maf-circle-fill)\" stroke=\"none\"\n                d=\"M 927.0 229.5 L 960.0 249.8 L 957.0 276.8 L 990.0 301.5 L 945.0 351.0 L 945.0 362.2 L 1023.0 425.2 L 1032.0 441.0 L 1029.0 508.5 L 1146.0 596.2 L 1134.0 632.2 L 1209.0 699.8 L 1209.0 715.5 L 1179.0 738.0 L 1179.0 753.8 L 1305.0 852.8 L 1296.0 882.0 L 1179.0 969.8 L 1095.0 983.2 L 1053.0 963.0 L 1005.0 999.0 L 927.0 999.0 L 927.0 956.2 L 942.0 956.2 L 957.0 942.8 L 948.0 861.8 L 1056.0 828.0 L 1074.0 882.0 L 1095.0 895.5 L 1146.0 888.8 L 1164.0 870.8 L 1164.0 855.0 L 1167.0 879.8 L 1179.0 879.8 L 1188.0 866.2 L 1188.0 852.8 L 1173.0 850.5 L 1158.0 825.8 L 1131.0 807.8 L 1104.0 807.8 L 1029.0 753.8 L 1029.0 726.8 L 1038.0 749.2 L 1062.0 747.0 L 1065.0 722.2 L 1050.0 720.0 L 1053.0 711.0 L 1065.0 708.8 L 1068.0 717.8 L 1092.0 715.5 L 1092.0 704.2 L 1071.0 702.0 L 1071.0 688.5 L 1050.0 684.0 L 1044.0 652.5 L 1017.0 643.5 L 1014.0 634.5 L 981.0 641.2 