{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      :root {\n        --maf-west: #703030;\n        --maf-west-deep: #603030;\n        --maf-land: #c8bca8;\n        --maf-land-alt: #b0a494;\n        --maf-sea: #1a1a28;\n        --maf-bg: #2a2420;\n        --maf-outer-tan: #c4a882;\n        --maf-sector-fr: #8e94a3;\n        --maf-sector-uk: #d6d2c9;\n        --maf-sector-us: #bda876;\n        --maf-sector-su: #703030;\n        --maf-circle: #703030;\n        --maf-arrow: #ffffff;\n        --maf-label: #ffffff;\n        --maf-border: #1a1210;\n        --maf-credit: rgba(232, 220, 196, 0.45);\n      }\n      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }\n      body { background: #0e0c0b; overflow: hidden; }\n      #root-map-arrow-fanout {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: var(--maf-bg);\n        font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n      }\n      #maf-stage {\n        position: absolute;\n        inset: 0;\n        overflow: hidden;\n        background: var(--maf-bg);\n      }\n      #maf-camera {\n        position: absolute;\n        left: 0; top: 0;\n        width: 1920px; height: 1080px;\n        transform-origin: 1038px 482px; /* Berlin measured pin */\n        will-change: transform;\n      }\n      #maf-svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n      #maf-berlin-layer {\n        position: absolute; inset: 0;\n        opacity: 0;\n        pointer-events: none;\n      }\n      #maf-berlin-svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n      #maf-endcard {\n        position: absolute; inset: 0;\n        opacity: 0;\n        pointer-events: none;\n        background: linea