approximate) -->\n            <path id=\"maf-ruins\" fill=\"#050508\"\n              d=\"M 0 1080 L 0 720\n                 L 40 700 L 60 640 L 90 660 L 110 580 L 140 600 L 160 520 L 200 540\n                 L 230 480 L 260 500 L 280 420 L 320 450 L 350 380 L 390 410 L 420 360\n                 L 460 400 L 500 340 L 540 390 L 580 320 L 620 370 L 660 300 L 700 350\n                 L 740 280 L 780 330 L 820 260 L 860 310 L 900 250 L 940 300 L 980 240\n                 L 1020 290 L 1060 230 L 1100 280 L 1140 220 L 1180 270 L 1220 210\n                 L 1260 260 L 1300 200 L 1340 250 L 1380 190 L 1420 240 L 1460 280\n                 L 1500 220 L 1540 270 L 1580 230 L 1620 290 L 1660 250 L 1700 310\n                 L 1740 270 L 1780 330 L 1820 290 L 1860 350 L 1900 320 L 1920 360\n                 L 1920 1080 Z\" />\n            <text x=\"960\" y=\"1000\" text-anchor=\"middle\" fill=\"rgba(255,255,255,0.35)\" font-size=\"18\" font-family=\"Helvetica, Arial, sans-serif\" letter-spacing=\"0.14em\">\n              ENDCARD APPROXIMATION - LIVE-ACTION NOT EMBEDDED\n            </text>\n          </svg>\n        </div>\n\n        <div id=\"maf-grain\"></div>\n        <div id=\"maf-vignette\"></div>\n      </div>\n      <div id=\"maf-credit\">\n        Inspired by Moving Image Archive - Animated Maps - not affiliated; footage not included\n      </div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var border = document.getElementById(\"maf-inner-border\");\n        var borderLen = border.getTotalLength();\n        gsap.set(border, { strokeDasharray: borderLen, strokeDashoffset: borderLen });\n\n        var arrowIds = [\"maf-a0\", \"maf-a1\", \"maf-a2\", \"maf-a3\", \"maf-a4\", \"maf-a5\"];\n        var arrowLens = [];\n        for (var i = 0; i < arrowIds.length; i++) {\n          var a = document.getElementById(arrowIds[i]);\n          var len = a.getTotalLength();\n          arrowLens.push(len);\n          gsap.set(a, { strokeDasharray: len, strokeDashoffset: len });\n          var tr = document.getElementById(arrowIds[i] + \"-trail\");\n          if (tr) {\n            var tlen = tr.getTotalLength();\n            gsap.set(tr, { strokeDasharray: tlen, strokeDashoffset: tlen });\n          }\n        }\n\n        gsap.set(\"#maf-camera\", { scale: 1, x: 0, y: 0 });\n        gsap.set(\"#maf-berlin-layer\", { opacity: 0 });\n        gsap.set(\"#maf-berlin-pin\", { opacity: 0 });\n        gsap.set(\"#maf-label-federal\", { opacity: 0 });\n        gsap.set(\"#maf-label-peoples\", { opacity: 0 });\n        gsap.set(\"#maf-both-red\", { opacity: 0 });\n        gsap.set(\"#maf-arrows\", { opacity: 0 });\n        gsap.set(\"#maf-berlin-label-close\", { opacity: 0 });\n        gsap.set(\"#maf-endcard\", { opacity: 0 });\n        gsap.set(\"#maf-stage\", { opacity: 0 });\n        gsap.set(\"#maf-east\", { fill: \"#909090\" });\n\n        var tl = gsap.timeline({ paused: true });\n\n        // Act1: fade in Germany\n        tl.to(\"#maf-stage\", { opacity: 1, duration: 0.9, ease: \"power1.out\" }, 0);\n\n        // Act1 end: jagged border draws N→S (~8-10s)\n        tl.to(border, { strokeDashoffset: 0, duration: 2.0, ease: \"none\" }, 8.0);\n\n        // Act2: BERLIN callout + zoom (~11-15)\n        tl.to(\"#maf-berlin-pin\", { opacity: 1, duration: 0.45, ease: \"power1.out\" }, 11.0);\n        tl.to(\n          \"#maf-camera\",\n          {\n            scale: 4.2,\n            x: -380,\n            y: 80,\n            duration: 3.8,\n            ease: \"power1.inOut\",\n            transformOrigin: \"1038px 482px\",\n          },\n          12.0\n        );\n\n        // Crossfade to Berlin sectors (~15.6)\n        tl.to(\"#maf-berlin-layer\", { opacity: 1, duration: 0.7, ease: \"power1.inOut\" }, 15.6);\n        tl.to(\"#maf-camera\", { opacity: 0.15, duration: 0.7 }, 15.6);\n        // BERLIN close-label: hidden on sector/airlift (not on ref t19/t23)\n        // tl.to(\"#maf-berlin-label-close\", { opacity: 1, duration: 0.4 }, 16.2);\n\n        // Act4: airlift arrows fan W→E (~21-26) - thick short shafts + trail bloom + heads\n        tl.to(\"#maf-arrows\", { opacity: 1, duration: 0.25 }, 20.8);\n        for (i = 0; i < arrowIds.length; i++) {\n          var start = 21.0 + i * 0.14;\n          var trailEl = document.getElementById(arrowIds[i] + \"-trail\");\n          if (trailEl) {\n            tl.to(trailEl, { strokeDashoffset: 0, duration: 0.7, ease: \"power2.out\" }, start);\n          }\n          tl.to(\n            document.getElementById(arrowIds[i]),\n            { strokeDashoffset: 0, duration: 0.55, ease: \"power2.out\" },\n            start + 0.05\n          );\n          tl.to(\n            document.getElementById(arrowIds[i] + \"-head\"),\n            { opacity: 1, duration: 0.25, ease: \"power1.out\" },\n            start + 0.4\n          );\n        }\n\n        // Act5: zoom out + republic labels (~26.5-34)\n        tl.to(\"#maf-arrows\", { opacity: 0, duration: 0.8 }, 26.2);\n        tl.to(\"#maf-berlin-label-close\", { opacity: 0, duration: 0.5 }, 26.2);\n        tl.to(\"#maf-berlin-layer\", { opacity: 0, duration: 1.0, ease: \"power1.inOut\" }, 26.5);\n        tl.to(\"#maf-camera\", { opacity: 1, scale: 1, x: 0, y: 0, duration: 3.5, ease: \"power1.inOut\" }, 26.5);\n        tl.to(\"#maf-both-red\", { opacity: 1, duration: 0.6 }, 28.0);\n        tl.to(\"#maf-west\", { opacity: 0, duration: 0.4 }, 28.0);\n        tl.to(\"#maf-east\", { opacity: 0, duration: 0.4 }, 28.0);\n        tl.to(\"#maf-label-federal\", { opacity: 1, duration: 0.5 }, 28.6);\n        tl.to(\"#maf-label-peoples\", { opacity: 1, duration: 0.5 }, 28.75);\n        tl.to(\"#maf-berlin-pin\", { opacity: 1, duration: 0.3 }, 28.5);\n\n        // Act6 endcard ruins (~34.8-39) - SVG approximation of live-action\n        tl.to(\"#maf-endcard\", { opacity: 1, duration: 1.3, ease: \"power1.inOut\" }, 34.8);\n        tl.to(\"#maf-camera\", { opacity: 0, duration: 1.2 }, 34.8);\n        tl.to(\"#maf-label-federal\", { opacity: 0, duration: 0.8 }, 34.8);\n        tl.to(\"#maf-label-peoples\", { opacity: 0, duration: 0.8 }, 34.8);\n        tl.to(\"#maf-berlin-pin\", { opacity: 0, duration: 0.8 }, 34.8);\n\n        // Hold to 39s\n        tl.to({}, { duration: 0.01 }, 39.0);\n\n        window.__timelines[\"map-arrow-fanout\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}