{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-boundary-morph {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mbm-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mbm-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mbm-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mbm-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mbm-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-boundary-morph\"\n      data-composition-id=\"map-boundary-morph\"\n      data-start=\"0\"\n      data-duration=\"8\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mbm-frame\">\n        <svg\n          id=\"mbm-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mbm-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mbm-hatch)\" />\n          <path\n            id=\"mbm-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mbm-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n\n          <path\n            id=\"mbm-old\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,92,38,0.18)\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2.5\"\n          />\n          <path\n            id=\"mbm-new\"\n            d=\"M 300 340 C 380 240 520 200 660 230 C 800 260 860 320 940 300 C 1020 280 1120 320 1220 360 C 1320 400 1400 480 1420 580 C 1440 680 1380 780 1280 840 C 1180 900 1020 920 900 880 C 780 840 740 800 660 820 C 580 840 460 800 400 720 C 340 640 280 520 300 340 Z\"\n            fill=\"rgba(196,92,38,0.18)\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2.5\"\n          />\n          <text\n            id=\"mbm-era1\"\n            x=\"420\"\n            y=\"280\"\n            fill=\"rgba(232,220,196,0.75)\"\n            font-size=\"20\"\n            font-family=\"Georgia, serif\"\n          >\n            ERA I\n          </text>\n          <text\n            id=\"mbm-era2\"\n            x=\"420\"\n            y=\"280\"\n            fill=\"rgba(232,220,196,0.75)\"\n            font-size=\"20\"\n            font-family=\"Georgia, serif\"\n          >\n            ERA II\n          </text>\n        </svg>\n      </div>\n      <div id=\"mbm-title\" data-var-text=\"title\">Shifting Borders</div>\n      <div id=\"mbm-subtitle\" data-var-text=\"subtitle\">Educational cartography · boundary morph</div>\n      <div id=\"mbm-note\">Simplified boundary crossfade · not a precise historical claim</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Shifting Borders\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 boundary morph\";\n\n        document.getElementById(\"mbm-title\").textContent = title;\n        document.getElementById(\"mbm-subtitle\").textContent = subtitle;\n        document.getElementById(\"mbm-old\").setAttribute(\"stroke\", accent);\n        document.getElementById(\"mbm-new\").setAttribute(\"stroke\", accent);\n        gsap.set(\n          [\n            \"#mbm-land\",\n            \"#mbm-island\",\n            \"#mbm-title\",\n            \"#mbm-subtitle\",\n            \"#mbm-note\",\n            \"#mbm-era1\",\n            \"#mbm-era2\",\n          ],\n          { opacity: 0 },\n        );\n        gsap.set(\"#mbm-old\", { opacity: 0 });\n        gsap.set(\"#mbm-new\", { opacity: 0 });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mbm-land\", { opacity: 0.35, duration: 0.5 }, 0);\n        tl.to(\"#mbm-island\", { opacity: 0.35, duration: 0.4 }, 0.1);\n        tl.to(\"#mbm-title\", { opacity: 1, duration: 0.4 }, 0.15);\n        tl.to(\"#mbm-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        tl.to([\"#mbm-old\", \"#mbm-era1\"], { opacity: 1, duration: 0.6 }, 0.8);\n        tl.to(\"#mbm-old\", { opacity: 0, duration: 1.4, ease: \"power1.inOut\" }, 3.2);\n        tl.to(\"#mbm-era1\", { opacity: 0, duration: 0.5 }, 3.2);\n        tl.to([\"#mbm-new\", \"#mbm-era2\"], { opacity: 1, duration: 1.4, ease: \"power1.inOut\" }, 3.2);\n        tl.to(\"#mbm-note\", { opacity: 1, duration: 0.4 }, 5.5);\n        window.__timelines[\"map-boundary-morph\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}