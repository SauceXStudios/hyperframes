redit === \"string\" && vars.credit\n            ? vars.credit\n            : \"Inspired by Moving Image Archive, How Our Country Grew, 1950 (Animated Maps) - not affiliated; recreation in code, footage not included.\";\n        document.getElementById(\"mca-title\").textContent = title;\n        document.getElementById(\"mca-subtitle\").textContent = subtitle;\n        document.getElementById(\"mca-credit\").textContent = credit;\n\n        var eastSpeed = num(vars.eastSpeed, 0.18);\n        var transSpeed = num(vars.transSpeed, 2.4);\n        var westSpeed = num(vars.westSpeed, 0.35);\n\n        var rails = Array.prototype.slice.call(document.querySelectorAll(\".mca-rail\"));\n        rails.forEach(function (el) {\n          var len = el.getTotalLength();\n          el.setAttribute(\"stroke\", \"var(--route)\");\n          gsap.set(el, { strokeDasharray: len, strokeDashoffset: len });\n        });\n\n        gsap.set(\"#mca-title\", { opacity: 0, y: -8 });\n        gsap.set(\"#mca-subtitle\", { opacity: 0 });\n        gsap.set(\"#mca-credit\", { opacity: 0 });\n        gsap.set(\"#mca-land\", { opacity: 0 });\n        gsap.set(\".mca-lake\", { opacity: 0 });\n\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mca-land\", { opacity: 1, duration: 0.55, ease: \"power2.out\" }, 0);\n        tl.to(\".mca-lake\", { opacity: 1, duration: 0.45, ease: \"power2.out\" }, 0.2);\n        tl.to(\"#mca-title\", { opacity: 1, y: 0, duration: 0.4, ease: \"power2.out\" }, 0.1);\n        tl.to(\"#mca-subtitle\", { opacity: 1, duration: 0.35, ease: \"power1.out\" }, 0.28);\n        tl.to(\"#mca-credit\", { opacity: 1, duration: 0.4, ease: \"power1.out\" }, 0.55);\n\n        var east = Array.prototype.slice.call(document.querySelectorAll(\".mca-east\"));\n        var t = 0.9;\n        east.forEach(function (el, i) {\n          tl.to(el, { strokeDashoffset: 0, duration: eastSpeed + (i % 3) * 0.05, ease: \"none\" }, t + i * 0.07);\n        });\n        t = 0.9 + east.length * 0.07 + 0.35;\n\n        var trans = Array.prototype.slice.call(document.querySelectorAll(\".mca-trans\"));\n        trans.forEach(function (el) {\n          tl.to(el, { strokeDashoffset: 0, duration: transSpeed, ease: \"power1.inOut\" }, t);\n        });\n        t += transSpeed + 0.15;\n\n        var west = Array.prototype.slice.call(document.querySelectorAll(\".mca-west\"));\n        west.forEach(function (el, i) {\n          tl.to(el, { strokeDashoffset: 0, duration: westSpeed, ease: \"power1.out\" }, t + i * 0.08);\n        });\n\n        window.__timelines[\"map-campaign-arrows\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}