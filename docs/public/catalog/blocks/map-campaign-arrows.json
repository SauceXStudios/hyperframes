{"html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-campaign-arrows {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mca-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mca-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mca-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n      }\n      #mca-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mca-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 720px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-campaign-arrows\"\n      data-composition-id=\"map-campaign-arrows\"\n      data-start=\"0\"\n      data-duration=\"9\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mca-frame\">\n        <svg\n          id=\"mca-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <marker\n              id=\"mca-head\"\n              markerWidth=\"12\"\n              markerHeight=\"12\"\n              refX=\"10\"\n              refY=\"6\"\n              orient=\"auto\"\n              markerUnits=\"strokeWidth\"\n            >\n              <path d=\"M 0 0 L 12 6 L 0 12 Z\" fill=\"#c45c26\" />\n            </marker>\n            <pattern\n              id=\"mca-hatch\"\n              width=\"11\"\n              height=\"11\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(45)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"11\" stroke=\"rgba(196,181,154,0.07)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mca-hatch)\" />\n          <path\n            id=\"mca-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mca-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n          <!-- abstract campaign arrows (educational / schematic) -->\n          <path\n            id=\"mca-a1\"\n            d=\"M 420 600 C 520 560 620 500 740 480\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"5\"\n            stroke-linecap=\"round\"\n            marker-end=\"url(#mca-head)\"\n          />\n          <path\n            id=\"mca-a2\"\n            d=\"M 760 470 C 860 430 960 420 1080 450\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"5\"\n            stroke-linecap=\"round\"\n            marker-end=\"url(#mca-head)\"\n          />\n          <path\n            id=\"mca-a3\"\n            d=\"M 1100 455 C 1200 480 1300 540 1380 620\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"5\"\n            stroke-linecap=\"round\"\n            marker-end=\"url(#mca-head)\"\n          />\n          <path\n            id=\"mca-a4\"\n            d=\"M 900 640 C 1000 600 1120 580 1240 560\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"4\"\n            stroke-linecap=\"round\"\n            marker-end=\"url(#mca-head)\"\n            opacity=\"0.75\"\n          />\n          <circle id=\"mca-origin\" cx=\"420\" cy=\"600\" r=\"11\" fill=\"#c45c26\" />\n          <text\n            id=\"mca-step1\"\n            x=\"580\"\n            y=\"520\"\n            fill=\"rgba(232,220,196,0.85)\"\n            font-size=\"18\"\n            font-family=\"Georgia, serif\"\n            opacity=\"0\"\n          >\n            I\n          </text>\n          <text\n            id=\"mca-step2\"\n            x=\"920\"\n            y=\"400\"\n            fill=\"rgba(232,220,196,0.85)\"\n            font-size=\"18\"\n            font-family=\"Georgia, serif\"\n            opacity=\"0\"\n          >\n            II\n          </text>\n          <text\n            id=\"mca-step3\"\n            x=\"1280\"\n            y=\"560\"\n            fill=\"rgba(232,220,196,0.85)\"\n            font-size=\"18\"\n            font-family=\"Georgia, serif\"\n            opacity=\"0\"\n          >\n            III\n          </text>\n          <text\n            id=\"mca-step4\"\n            x=\"1080\"\n            y=\"620\"\n            fill=\"rgba(232,220,196,0.7)\"\n            font-size=\"16\"\n            font-family=\"Georgia, serif\"\n            opacity=\"0\"\n          >\n            IV\n          </text>\n        </svg>\n      </div>\n      <div id=\"mca-title\" data-var-text=\"title\">Schematic Advances</div>\n      <div id=\"mca-subtitle\" data-var-text=\"subtitle\">\n        Sequential path arrows · abstract cartography\n      </div>\n      <div id=\"mca-note\">Abstract educational diagram - not a depiction of any real campaign</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title =\n          typeof vars.title === \"string\" && vars.title ? vars.title : \"Schematic Advances\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Sequential path arrows · abstract cartography\";\n\n        document.getElementById(\"mca-title\").textContent = title;\n        document.getElementById(\"mca-subtitle\").textContent = subtitle;\n\n        var head = document.querySelector(\"#mca-head path\");\n        if (head) head.setAttribute(\"fill\", accent);\n        document.getElementById(\"mca-origin\").setAttribute(\"fill\", accent);\n\n        var arrows = [\"mca-a1\", \"mca-a2\", \"mca-a3\", \"mca-a4\"];\n        var steps = [\"mca-step1\", \"mca-step2\", \"mca-step3\", \"mca-step4\"];\n        var lens = [];\n        for (var i = 0; i < arrows.length; i++) {\n          var el = document.getElementById(arrows[i]);\n          el.setAttribute(\"stroke\", accent);\n          var len = el.getTotalLength();\n          lens.push(len);\n          gsap.set(el, { strokeDasharray: len, strokeDashoffset: len });\n        }\n\n        gsap.set(\"#mca-title\", { opacity: 0, y: -10 });\n        gsap.set(\"#mca-subtitle\", { opacity: 0 });\n        gsap.set(\"#mca-note\", { opacity: 0 });\n        gsap.set(\"#mca-land\", { opacity: 0 });\n        gsap.set(\"#mca-island\", { opacity: 0 });\n        gsap.set(\"#mca-origin\", { scale: 0, transformOrigin: \"50% 50%\" });\n        gsap.set(\n          steps.map(function (id) {\n            return \"#\" + id;\n          }),\n          { opacity: 0 },\n        );\n\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mca-land\", { opacity: 1, duration: 0.5, ease: \"power2.out\" }, 0);\n        tl.to(\"#mca-island\", { opacity: 1, duration: 0.4, ease: \"power2.out\" }, 0.12);\n        tl.to(\"#mca-title\", { opacity: 1, y: 0, duration: 0.45, ease: \"power2.out\" }, 0.08);\n        tl.to(\"#mca-subtitle\", { opacity: 1, duration: 0.35, ease: \"power1.out\" }, 0.28);\n        tl.to(\"#mca-origin\", { scale: 1, duration: 0.35, ease: \"back.out(1.8)\" }, 0.7);\n        tl.to(\"#mca-note\", { opacity: 1, duration: 0.4, ease: \"power1.out\" }, 0.9);\n\n        var t = 1.2;\n        for (i = 0; i < arrows.length; i++) {\n          var a = document.getElementById(arrows[i]);\n          var dur = i === 3 ? 1.0 : 1.15;\n          tl.to(a, { strokeDashoffset: 0, duration: dur, ease: \"power1.inOut\" }, t);\n          tl.to(\"#\" + steps[i], { opacity: 1, duration: 0.25, ease: \"power1.out\" }, t + dur * 0.7);\n          t += dur + 0.18;\n        }\n\n        window.__timelines[\"map-campaign-arrows\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}
