{"html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-city-pins {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mcp-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mcp-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mcp-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n      }\n      #mcp-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-city-pins\"\n      data-composition-id=\"map-city-pins\"\n      data-start=\"0\"\n      data-duration=\"8\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mcp-frame\">\n        <svg\n          id=\"mcp-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mcp-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(28)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.07)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mcp-hatch)\" />\n          <path\n            id=\"mcp-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mcp-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n          <!-- pins -->\n          <g id=\"mcp-pin-0\" class=\"mcp-pin\" transform=\"translate(480,480)\">\n            <circle class=\"mcp-dot\" r=\"9\" fill=\"#c45c26\" />\n            <circle class=\"mcp-ring\" r=\"18\" fill=\"none\" stroke=\"#c45c26\" stroke-width=\"2\" />\n            <text\n              class=\"mcp-label\"\n              x=\"0\"\n              y=\"-28\"\n              text-anchor=\"middle\"\n              fill=\"rgba(232,220,196,0.92)\"\n              font-size=\"22\"\n              font-family=\"Georgia, serif\"\n            >\n              NORTH\n            </text>\n          </g>\n          <g id=\"mcp-pin-1\" class=\"mcp-pin\" transform=\"translate(760,560)\">\n            <circle class=\"mcp-dot\" r=\"9\" fill=\"#c45c26\" />\n            <circle class=\"mcp-ring\" r=\"18\" fill=\"none\" stroke=\"#c45c26\" stroke-width=\"2\" />\n            <text\n              class=\"mcp-label\"\n              x=\"0\"\n              y=\"-28\"\n              text-anchor=\"middle\"\n              fill=\"rgba(232,220,196,0.92)\"\n              font-size=\"22\"\n              font-family=\"Georgia, serif\"\n            >\n              CENTRAL\n            </text>\n          </g>\n          <g id=\"mcp-pin-2\" class=\"mcp-pin\" transform=\"translate(1040,500)\">\n            <circle class=\"mcp-dot\" r=\"9\" fill=\"#c45c26\" />\n            <circle class=\"mcp-ring\" r=\"18\" fill=\"none\" stroke=\"#c45c26\" stroke-width=\"2\" />\n            <text\n              class=\"mcp-label\"\n              x=\"0\"\n              y=\"-28\"\n              text-anchor=\"middle\"\n              fill=\"rgba(232,220,196,0.92)\"\n              font-size=\"22\"\n              font-family=\"Georgia, serif\"\n            >\n              EAST\n            </text>\n          </g>\n          <g id=\"mcp-pin-3\" class=\"mcp-pin\" transform=\"translate(1240,660)\">\n            <circle class=\"mcp-dot\" r=\"9\" fill=\"#c45c26\" />\n            <circle class=\"mcp-ring\" r=\"18\" fill=\"none\" stroke=\"#c45c26\" stroke-width=\"2\" />\n            <text\n              class=\"mcp-label\"\n              x=\"0\"\n              y=\"-28\"\n              text-anchor=\"middle\"\n              fill=\"rgba(232,220,196,0.92)\"\n              font-size=\"22\"\n              font-family=\"Georgia, serif\"\n            >\n              SOUTH\n            </text>\n          </g>\n          <g id=\"mcp-pin-4\" class=\"mcp-pin\" transform=\"translate(1520,480)\">\n            <circle class=\"mcp-dot\" r=\"9\" fill=\"#c45c26\" />\n            <circle class=\"mcp-ring\" r=\"18\" fill=\"none\" stroke=\"#c45c26\" stroke-width=\"2\" />\n            <text\n              class=\"mcp-label\"\n              x=\"0\"\n              y=\"-28\"\n              text-anchor=\"middle\"\n              fill=\"rgba(232,220,196,0.92)\"\n              font-size=\"22\"\n              font-family=\"Georgia, serif\"\n            >\n              ISLE\n            </text>\n          </g>\n        </svg>\n      </div>\n      <div id=\"mcp-title\" data-var-text=\"title\">Cities of Note</div>\n      <div id=\"mcp-subtitle\" data-var-text=\"subtitle\">Staggered pin drops · educational map</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Cities of Note\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Staggered pin drops · educational map\";\n        var labels = [\n          typeof vars.city1 === \"string\" && vars.city1 ? vars.city1 : \"NORTH\",\n          typeof vars.city2 === \"string\" && vars.city2 ? vars.city2 : \"CENTRAL\",\n          typeof vars.city3 === \"string\" && vars.city3 ? vars.city3 : \"EAST\",\n          typeof vars.city4 === \"string\" && vars.city4 ? vars.city4 : \"SOUTH\",\n          typeof vars.city5 === \"string\" && vars.city5 ? vars.city5 : \"ISLE\",\n        ];\n\n        document.getElementById(\"mcp-title\").textContent = title;\n        document.getElementById(\"mcp-subtitle\").textContent = subtitle;\n\n        var pins = [];\n        for (var i = 0; i < 5; i++) {\n          var g = document.getElementById(\"mcp-pin-\" + i);\n          var dot = g.querySelector(\".mcp-dot\");\n          var ring = g.querySelector(\".mcp-ring\");\n          var lab = g.querySelector(\".mcp-label\");\n          dot.setAttribute(\"fill\", accent);\n          ring.setAttribute(\"stroke\", accent);\n          lab.textContent = labels[i];\n          pins.push(g);\n        }\n\n        gsap.set(\"#mcp-title\", { opacity: 0, y: -10 });\n        gsap.set(\"#mcp-subtitle\", { opacity: 0 });\n        gsap.set(\"#mcp-land\", { opacity: 0 });\n        gsap.set(\"#mcp-island\", { opacity: 0 });\n        gsap.set(pins, { opacity: 0, scale: 0, transformOrigin: \"50% 50%\" });\n        gsap.set(\".mcp-label\", { opacity: 0, y: 8 });\n\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mcp-land\", { opacity: 1, duration: 0.5, ease: \"power2.out\" }, 0);\n        tl.to(\"#mcp-island\", { opacity: 1, duration: 0.4, ease: \"power2.out\" }, 0.12);\n        tl.to(\"#mcp-title\", { opacity: 1, y: 0, duration: 0.45, ease: \"power2.out\" }, 0.08);\n        tl.to(\"#mcp-subtitle\", { opacity: 1, duration: 0.35, ease: \"power1.out\" }, 0.3);\n\n        for (i = 0; i < pins.length; i++) {\n          var t = 0.85 + i * 0.45;\n          tl.to(pins[i], { opacity: 1, scale: 1, duration: 0.4, ease: \"back.out(2.2)\" }, t);\n          tl.to(\n            pins[i].querySelector(\".mcp-label\"),\n            { opacity: 1, y: 0, duration: 0.3, ease: \"power2.out\" },\n            t + 0.12,\n          );\n          tl.fromTo(\n            pins[i].querySelector(\".mcp-ring\"),\n            { scale: 0.6, opacity: 0 },\n            {\n              scale: 1,\n              opacity: 1,\n              duration: 0.35,\n              ease: \"power2.out\",\n              transformOrigin: \"50% 50%\",\n            },\n            t,\n          );\n        }\n\n        window.__timelines[\"map-city-pins\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}
