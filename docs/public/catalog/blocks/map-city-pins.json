{"html":"<!doctype html>\n<html lang=\"en\">\n  <head><base href=\"/public/catalog/items/map-city-pins/\">\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #0a0a0a;\n        overflow: hidden;\n      }\n      #root-map-city-pins {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #0a0a0a;\n        font-family: \"Helvetica Neue\", Helvetica, sans-serif;\n      }\n      #cp-video {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: contain;\n        background: #000;\n      }\n      #cp-frame {\n        position: absolute;\n        inset: 36px;\n        border: 1px solid rgba(232, 220, 196, 0.28);\n        pointer-events: none;\n      }\n      #cp-title {\n        position: absolute;\n        left: 72px;\n        top: 56px;\n        max-width: 1600px;\n        color: rgba(245, 236, 214, 0.95);\n        font-size: 34px;\n        font-weight: 700;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.75);\n      }\n      #cp-credit {\n        position: absolute;\n        left: 72px;\n        right: 72px;\n        bottom: 56px;\n        color: rgba(232, 220, 196, 0.88);\n        font-size: 16px;\n        letter-spacing: 0.06em;\n        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);\n      }\n      #cp-credit-url {\n        display: block;\n        margin-top: 8px;\n        font-size: 13px;\n        letter-spacing: 0.03em;\n        color: rgba(196, 181, 154, 0.7);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-city-pins\"\n      data-composition-id=\"map-city-pins\"\n      data-start=\"0\"\n      data-duration=\"12.01\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <video\n        id=\"cp-video\"\n        src=\"/public/catalog/assets/a4d2c9e2268dbb39.mp4\"\n        muted\n        playsinline\n        preload=\"auto\"\n        data-start=\"0\"\n        data-duration=\"12.01\"\n        data-media-start=\"0\"\n      ></video>\n      <div id=\"cp-frame\" aria-hidden=\"true\"></div>\n      <div id=\"cp-title\" data-var-text=\"title\">New York Water Supply (1927)</div>\n      <div id=\"cp-credit\">\n        <span data-var-text=\"credit\"\n          >Moving Image Archive, New York Water Supply, 1927; National Archives and Records\n          Administration / U.S. Government Films (Internet Archive collection);\n          https://archive.org/details/gov.archives.arc.95622</span\n        >\n        <span id=\"cp-credit-url\"\n          >https://www.movingimagearchive.com/sources/new-york-water-supply-0dcea171?clip=5791dad1-539e-5947-863e-f19cbac765ba\n          - Rights: public_domain / free to reuse</span\n        >\n      </div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n\n        var title =\n          typeof vars.title === \"string\" && vars.title\n            ? vars.title\n            : \"New York Water Supply (1927)\";\n        var credit =\n          typeof vars.credit === \"string\" && vars.credit\n            ? vars.credit\n            : \"Moving Image Archive, New York Water Supply, 1927; National Archives and Records Administration / U.S. Government Films (Internet Archive collection); https://archive.org/details/gov.archives.arc.95622\";\n\n        document.getElementById(\"cp-title\").textContent = title;\n        document.querySelector('#cp-credit [data-var-text=\"credit\"]').textContent = credit;\n\n        var tl = gsap.timeline({ paused: true });\n        tl.fromTo(\n          \"#cp-title\",\n          { opacity: 0 },\n          { opacity: 1, duration: 0.6, ease: \"power1.out\" },\n          0,\n        );\n        tl.fromTo(\n          \"#cp-credit\",\n          { opacity: 0 },\n          { opacity: 1, duration: 0.6, ease: \"power1.out\" },\n          0.15,\n        );\n        tl.to({}, { duration: Math.max(0.01, 12.01 - 0.75) });\n\n        window.__timelines[\"map-city-pins\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}