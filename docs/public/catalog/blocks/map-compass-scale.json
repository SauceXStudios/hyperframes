{"html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-compass-scale {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mcs-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mcs-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mcs-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mcs-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mcs-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-compass-scale\"\n      data-composition-id=\"map-compass-scale\"\n      data-start=\"0\"\n      data-duration=\"7\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mcs-frame\">\n        <svg\n          id=\"mcs-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mcs-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mcs-hatch)\" />\n          <path\n            id=\"mcs-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mcs-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n\n          <g id=\"mcs-compass\" transform=\"translate(420 780)\">\n            <circle\n              cx=\"0\"\n              cy=\"0\"\n              r=\"70\"\n              fill=\"#1a1714\"\n              stroke=\"rgba(196,181,154,0.45)\"\n              stroke-width=\"2\"\n            />\n            <polygon id=\"mcs-needle-n\" points=\"0,-58 10,8 -10,8\" fill=\"#c45c26\" />\n            <polygon points=\"0,58 8,-4 -8,-4\" fill=\"rgba(232,220,196,0.55)\" />\n            <text\n              x=\"0\"\n              y=\"-78\"\n              text-anchor=\"middle\"\n              fill=\"rgba(232,220,196,0.8)\"\n              font-size=\"16\"\n              font-family=\"Georgia, serif\"\n            >\n              N\n            </text>\n          </g>\n          <g id=\"mcs-scale\" transform=\"translate(1280 820)\">\n            <line x1=\"0\" y1=\"0\" x2=\"220\" y2=\"0\" stroke=\"#c45c26\" stroke-width=\"4\" />\n            <line x1=\"0\" y1=\"-10\" x2=\"0\" y2=\"10\" stroke=\"#c45c26\" stroke-width=\"3\" />\n            <line x1=\"110\" y1=\"-8\" x2=\"110\" y2=\"8\" stroke=\"#c45c26\" stroke-width=\"2\" />\n            <line x1=\"220\" y1=\"-10\" x2=\"220\" y2=\"10\" stroke=\"#c45c26\" stroke-width=\"3\" />\n            <text\n              id=\"mcs-scale-label\"\n              x=\"110\"\n              y=\"32\"\n              text-anchor=\"middle\"\n              fill=\"rgba(232,220,196,0.8)\"\n              font-size=\"18\"\n              font-family=\"Georgia, serif\"\n            >\n              100 mi\n            </text>\n          </g>\n        </svg>\n      </div>\n      <div id=\"mcs-title\" data-var-text=\"title\">Compass & Scale</div>\n      <div id=\"mcs-subtitle\" data-var-text=\"subtitle\">Educational cartography · compass rose</div>\n      <div id=\"mcs-note\">Compass rose + scale bar · cartographic chrome</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Compass & Scale\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 compass rose\";\n        var scaleLabel =\n          typeof vars.scaleLabel === \"string\" && vars.scaleLabel ? vars.scaleLabel : \"100 mi\";\n\n        document.getElementById(\"mcs-title\").textContent = title;\n        document.getElementById(\"mcs-subtitle\").textContent = subtitle;\n        document.getElementById(\"mcs-scale-label\").textContent = scaleLabel;\n        document.getElementById(\"mcs-needle-n\").setAttribute(\"fill\", accent);\n        document.querySelectorAll(\"#mcs-scale line\").forEach(function (el) {\n          el.setAttribute(\"stroke\", accent);\n        });\n        gsap.set([\"#mcs-land\", \"#mcs-island\", \"#mcs-title\", \"#mcs-subtitle\", \"#mcs-note\"], {\n          opacity: 0,\n        });\n        gsap.set(\"#mcs-compass\", {\n          opacity: 0,\n          scale: 0.6,\n          rotationOrigin: \"50% 50%\",\n          svgOrigin: \"420px 780px\",\n        });\n        gsap.set(\"#mcs-scale\", {\n          opacity: 0,\n          scaleX: 0,\n          transformOrigin: \"0% 50%\",\n          svgOrigin: \"1280px 820px\",\n        });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mcs-land\", { opacity: 1, duration: 0.5 }, 0);\n        tl.to(\"#mcs-island\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#mcs-title\", { opacity: 1, duration: 0.4 }, 0.15);\n        tl.to(\"#mcs-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        tl.to(\"#mcs-compass\", { opacity: 1, scale: 1, duration: 0.7, ease: \"back.out(1.6)\" }, 1.0);\n        tl.to(\"#mcs-scale\", { opacity: 1, scaleX: 1, duration: 0.9, ease: \"power2.out\" }, 2.0);\n        tl.to(\"#mcs-note\", { opacity: 1, duration: 0.4 }, 4.0);\n        window.__timelines[\"map-compass-scale\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}
