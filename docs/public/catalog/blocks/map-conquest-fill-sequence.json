{"html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-conquest-fill-sequence {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mcf-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mcf-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mcf-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mcf-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mcf-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-conquest-fill-sequence\"\n      data-composition-id=\"map-conquest-fill-sequence\"\n      data-start=\"0\"\n      data-duration=\"8\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mcf-frame\">\n        <svg\n          id=\"mcf-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mcf-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mcf-hatch)\" />\n          <path\n            id=\"mcf-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mcf-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n          <path\n            id=\"mcf-r1\"\n            d=\"M 400 500 C 480 440 560 450 600 520 C 640 590 560 650 480 640 C 400 630 360 560 400 500 Z\"\n            fill=\"#c45c26\"\n            opacity=\"0.35\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mcf-r2\"\n            d=\"M 620 420 C 720 380 820 400 860 480 C 900 560 820 620 720 610 C 620 600 560 500 620 420 Z\"\n            fill=\"#c45c26\"\n            opacity=\"0.35\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mcf-r3\"\n            d=\"M 880 460 C 980 420 1080 450 1120 530 C 1160 610 1080 680 980 670 C 880 660 820 540 880 460 Z\"\n            fill=\"#c45c26\"\n            opacity=\"0.35\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mcf-r4\"\n            d=\"M 1140 520 C 1240 480 1340 520 1360 600 C 1380 680 1280 740 1180 720 C 1080 700 1060 580 1140 520 Z\"\n            fill=\"#c45c26\"\n            opacity=\"0.35\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n          />\n        </svg>\n      </div>\n      <div id=\"mcf-title\" data-var-text=\"title\">Sequential Fill</div>\n      <div id=\"mcf-subtitle\" data-var-text=\"subtitle\">Educational cartography · conquest fill</div>\n      <div id=\"mcf-note\">Abstract sequential fill - not a depiction of any real conquest</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Sequential Fill\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 conquest fill\";\n\n        document.getElementById(\"mcf-title\").textContent = title;\n        document.getElementById(\"mcf-subtitle\").textContent = subtitle;\n        [\"mcf-r1\", \"mcf-r2\", \"mcf-r3\", \"mcf-r4\"].forEach(function (id) {\n          var el = document.getElementById(id);\n          el.setAttribute(\"fill\", accent);\n          el.setAttribute(\"stroke\", accent);\n        });\n        gsap.set([\"#mcf-land\", \"#mcf-island\", \"#mcf-title\", \"#mcf-subtitle\", \"#mcf-note\"], {\n          opacity: 0,\n        });\n        gsap.set([\"#mcf-r1\", \"#mcf-r2\", \"#mcf-r3\", \"#mcf-r4\"], {\n          opacity: 0,\n          scale: 0.85,\n          transformOrigin: \"50% 50%\",\n        });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mcf-land\", { opacity: 1, duration: 0.5 }, 0);\n        tl.to(\"#mcf-island\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#mcf-title\", { opacity: 1, duration: 0.4 }, 0.15);\n        tl.to(\"#mcf-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        tl.to(\"#mcf-r1\", { opacity: 0.4, scale: 1, duration: 0.7, ease: \"power2.out\" }, 1.0);\n        tl.to(\"#mcf-r2\", { opacity: 0.4, scale: 1, duration: 0.7, ease: \"power2.out\" }, 2.0);\n        tl.to(\"#mcf-r3\", { opacity: 0.4, scale: 1, duration: 0.7, ease: \"power2.out\" }, 3.0);\n        tl.to(\"#mcf-r4\", { opacity: 0.4, scale: 1, duration: 0.7, ease: \"power2.out\" }, 4.0);\n        tl.to(\"#mcf-note\", { opacity: 1, duration: 0.4 }, 5.2);\n        window.__timelines[\"map-conquest-fill-sequence\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}
