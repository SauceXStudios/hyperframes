{"html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-front-line-crawl {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mfl-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mfl-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mfl-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mfl-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mfl-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-front-line-crawl\"\n      data-composition-id=\"map-front-line-crawl\"\n      data-start=\"0\"\n      data-duration=\"8\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mfl-frame\">\n        <svg\n          id=\"mfl-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mfl-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mfl-hatch)\" />\n          <path\n            id=\"mfl-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mfl-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n\n          <path\n            id=\"mfl-front\"\n            d=\"M 360 700 C 480 640 600 580 740 560 C 880 540 1000 520 1140 540 C 1260 556 1360 600 1460 660\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"4\"\n            stroke-dasharray=\"14 10\"\n            stroke-linecap=\"round\"\n          />\n          <circle id=\"mfl-head\" cx=\"360\" cy=\"700\" r=\"9\" fill=\"#c45c26\" />\n        </svg>\n      </div>\n      <div id=\"mfl-title\" data-var-text=\"title\">The Shifting Front</div>\n      <div id=\"mfl-subtitle\" data-var-text=\"subtitle\">\n        Educational cartography · front-line crawl\n      </div>\n      <div id=\"mfl-note\">Abstract schematic - not a depiction of any real conflict</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title =\n          typeof vars.title === \"string\" && vars.title ? vars.title : \"The Shifting Front\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 front-line crawl\";\n\n        document.getElementById(\"mfl-title\").textContent = title;\n        document.getElementById(\"mfl-subtitle\").textContent = subtitle;\n        var front = document.getElementById(\"mfl-front\");\n        var head = document.getElementById(\"mfl-head\");\n        front.setAttribute(\"stroke\", accent);\n        head.setAttribute(\"fill\", accent);\n        var len = front.getTotalLength();\n        gsap.set(front, { strokeDasharray: \"14 10\", strokeDashoffset: len });\n        gsap.set([\"#mfl-land\", \"#mfl-island\", \"#mfl-title\", \"#mfl-subtitle\", \"#mfl-note\", head], {\n          opacity: 0,\n        });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mfl-land\", { opacity: 1, duration: 0.5 }, 0);\n        tl.to(\"#mfl-island\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#mfl-title\", { opacity: 1, duration: 0.45 }, 0.15);\n        tl.to(\"#mfl-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        tl.to(head, { opacity: 1, duration: 0.25 }, 0.6);\n        tl.to(front, { strokeDashoffset: 0, duration: 4.0, ease: \"none\" }, 0.85);\n        tl.to(front, { strokeDashoffset: -56, duration: 2.4, ease: \"none\" }, 4.9);\n        tl.to(\"#mfl-note\", { opacity: 1, duration: 0.4 }, 5.2);\n        window.__timelines[\"map-front-line-crawl\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}
