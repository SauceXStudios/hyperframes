{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-globe-inset {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mgi-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mgi-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mgi-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mgi-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mgi-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-globe-inset\"\n      data-composition-id=\"map-globe-inset\"\n      data-start=\"0\"\n      data-duration=\"9\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mgi-frame\">\n        <svg\n          id=\"mgi-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mgi-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mgi-hatch)\" />\n          <path\n            id=\"mgi-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mgi-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n\n          <g id=\"mgi-globe\">\n            <circle\n              cx=\"1560\"\n              cy=\"280\"\n              r=\"110\"\n              fill=\"#1a1714\"\n              stroke=\"rgba(196,181,154,0.5)\"\n              stroke-width=\"2\"\n            />\n            <g id=\"mgi-globe-spin\" transform=\"translate(1560 280)\">\n              <ellipse\n                id=\"mgi-meridian\"\n                cx=\"0\"\n                cy=\"0\"\n                rx=\"42\"\n                ry=\"110\"\n                fill=\"none\"\n                stroke=\"#c45c26\"\n                stroke-width=\"2\"\n              />\n              <ellipse\n                cx=\"0\"\n                cy=\"0\"\n                rx=\"110\"\n                ry=\"40\"\n                fill=\"none\"\n                stroke=\"rgba(196,181,154,0.35)\"\n                stroke-width=\"1.5\"\n              />\n              <path\n                d=\"M -90 -20 C -40 -50 40 -45 90 -15\"\n                fill=\"none\"\n                stroke=\"rgba(196,181,154,0.4)\"\n                stroke-width=\"2\"\n              />\n              <path\n                d=\"M -70 30 C -20 10 30 15 80 35\"\n                fill=\"none\"\n                stroke=\"rgba(196,181,154,0.35)\"\n                stroke-width=\"1.5\"\n              />\n            </g>\n            <circle\n              cx=\"1560\"\n              cy=\"280\"\n              r=\"110\"\n              fill=\"none\"\n              stroke=\"rgba(232,220,196,0.25)\"\n              stroke-width=\"1\"\n            />\n          </g>\n          <rect\n            id=\"mgi-inset-frame\"\n            x=\"1435\"\n            y=\"155\"\n            width=\"250\"\n            height=\"250\"\n            fill=\"none\"\n            stroke=\"rgba(196,181,154,0.35)\"\n            stroke-width=\"1.5\"\n          />\n        </svg>\n      </div>\n      <div id=\"mgi-title\" data-var-text=\"title\">World Inset</div>\n      <div id=\"mgi-subtitle\" data-var-text=\"subtitle\">Educational cartography · globe inset</div>\n      <div id=\"mgi-note\">Inset globe · GSAP rotation only · seek-safe</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"World Inset\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 globe inset\";\n\n        document.getElementById(\"mgi-title\").textContent = title;\n        document.getElementById(\"mgi-subtitle\").textContent = subtitle;\n        document.getElementById(\"mgi-meridian\").setAttribute(\"stroke\", accent);\n        gsap.set(\n          [\n            \"#mgi-land\",\n            \"#mgi-island\",\n            \"#mgi-globe\",\n            \"#mgi-inset-frame\",\n            \"#mgi-title\",\n            \"#mgi-subtitle\",\n            \"#mgi-note\",\n          ],\n          { opacity: 0 },\n        );\n        gsap.set(\"#mgi-globe-spin\", {\n          transformOrigin: \"0px 0px\",\n          rotation: 0,\n          svgOrigin: \"1560px 280px\",\n        });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mgi-land\", { opacity: 1, duration: 0.5 }, 0);\n        tl.to(\"#mgi-island\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#mgi-title\", { opacity: 1, duration: 0.4 }, 0.15);\n        tl.to(\"#mgi-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        tl.to([\"#mgi-globe\", \"#mgi-inset-frame\"], { opacity: 1, duration: 0.5 }, 0.7);\n        tl.to(\"#mgi-globe-spin\", { rotation: 360, duration: 6.5, ease: \"none\" }, 1.2);\n        tl.to(\"#mgi-note\", { opacity: 1, duration: 0.4 }, 6.5);\n        window.__timelines[\"map-globe-inset\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}