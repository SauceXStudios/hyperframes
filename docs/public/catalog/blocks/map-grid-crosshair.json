{"html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-grid-crosshair {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mgc-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mgc-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mgc-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mgc-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mgc-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-grid-crosshair\"\n      data-composition-id=\"map-grid-crosshair\"\n      data-start=\"0\"\n      data-duration=\"7\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mgc-frame\">\n        <svg\n          id=\"mgc-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mgc-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mgc-hatch)\" />\n          <path\n            id=\"mgc-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mgc-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n\n          <g id=\"mgc-grid\">\n            <line\n              class=\"mgc-v\"\n              x1=\"240\"\n              y1=\"160\"\n              x2=\"240\"\n              y2=\"920\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-v\"\n              x1=\"360\"\n              y1=\"160\"\n              x2=\"360\"\n              y2=\"920\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-v\"\n              x1=\"480\"\n              y1=\"160\"\n              x2=\"480\"\n              y2=\"920\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-v\"\n              x1=\"600\"\n              y1=\"160\"\n              x2=\"600\"\n              y2=\"920\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-v\"\n              x1=\"720\"\n              y1=\"160\"\n              x2=\"720\"\n              y2=\"920\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-v\"\n              x1=\"840\"\n              y1=\"160\"\n              x2=\"840\"\n              y2=\"920\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-v\"\n              x1=\"960\"\n              y1=\"160\"\n              x2=\"960\"\n              y2=\"920\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-v\"\n              x1=\"1080\"\n              y1=\"160\"\n              x2=\"1080\"\n              y2=\"920\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-v\"\n              x1=\"1200\"\n              y1=\"160\"\n              x2=\"1200\"\n              y2=\"920\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-v\"\n              x1=\"1320\"\n              y1=\"160\"\n              x2=\"1320\"\n              y2=\"920\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-v\"\n              x1=\"1440\"\n              y1=\"160\"\n              x2=\"1440\"\n              y2=\"920\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-v\"\n              x1=\"1560\"\n              y1=\"160\"\n              x2=\"1560\"\n              y2=\"920\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-v\"\n              x1=\"1680\"\n              y1=\"160\"\n              x2=\"1680\"\n              y2=\"920\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-h\"\n              x1=\"200\"\n              y1=\"200\"\n              x2=\"1720\"\n              y2=\"200\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-h\"\n              x1=\"200\"\n              y1=\"300\"\n              x2=\"1720\"\n              y2=\"300\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-h\"\n              x1=\"200\"\n              y1=\"400\"\n              x2=\"1720\"\n              y2=\"400\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-h\"\n              x1=\"200\"\n              y1=\"500\"\n              x2=\"1720\"\n              y2=\"500\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-h\"\n              x1=\"200\"\n              y1=\"600\"\n              x2=\"1720\"\n              y2=\"600\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-h\"\n              x1=\"200\"\n              y1=\"700\"\n              x2=\"1720\"\n              y2=\"700\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n            <line\n              class=\"mgc-h\"\n              x1=\"200\"\n              y1=\"800\"\n              x2=\"1720\"\n              y2=\"800\"\n              stroke=\"rgba(196,181,154,0.18)\"\n              stroke-width=\"1\"\n            />\n          </g>\n          <line\n            id=\"mgc-ch-h\"\n            x1=\"200\"\n            y1=\"520\"\n            x2=\"1720\"\n            y2=\"520\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n          />\n          <line\n            id=\"mgc-ch-v\"\n            x1=\"980\"\n            y1=\"160\"\n            x2=\"980\"\n            y2=\"920\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n          />\n          <circle\n            id=\"mgc-lock\"\n            cx=\"980\"\n            cy=\"520\"\n            r=\"16\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"3\"\n          />\n          <circle id=\"mgc-dot\" cx=\"980\" cy=\"520\" r=\"5\" fill=\"#c45c26\" />\n        </svg>\n      </div>\n      <div id=\"mgc-title\" data-var-text=\"title\">Grid Lock</div>\n      <div id=\"mgc-subtitle\" data-var-text=\"subtitle\">Educational cartography · lat-long lock</div>\n      <div id=\"mgc-note\">Grid draw + crosshair lock · schematic only</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Grid Lock\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 lat-long lock\";\n\n        document.getElementById(\"mgc-title\").textContent = title;\n        document.getElementById(\"mgc-subtitle\").textContent = subtitle;\n        [\"mgc-ch-h\", \"mgc-ch-v\", \"mgc-lock\"].forEach(function (id) {\n          document.getElementById(id).setAttribute(\"stroke\", accent);\n        });\n        document.getElementById(\"mgc-dot\").setAttribute(\"fill\", accent);\n        gsap.set(\n          [\"#mgc-land\", \"#mgc-island\", \"#mgc-title\", \"#mgc-subtitle\", \"#mgc-note\", \"#mgc-grid\"],\n          { opacity: 0 },\n        );\n        gsap.set([\"#mgc-ch-h\", \"#mgc-ch-v\"], { opacity: 0, scaleX: 0, transformOrigin: \"50% 50%\" });\n        gsap.set(\"#mgc-ch-v\", { scaleX: 1, scaleY: 0 });\n        gsap.set([\"#mgc-lock\", \"#mgc-dot\"], {\n          opacity: 0,\n          scale: 0.4,\n          transformOrigin: \"50% 50%\",\n          svgOrigin: \"980px 520px\",\n        });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mgc-land\", { opacity: 1, duration: 0.5 }, 0);\n        tl.to(\"#mgc-island\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#mgc-title\", { opacity: 1, duration: 0.4 }, 0.15);\n        tl.to(\"#mgc-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        tl.to(\"#mgc-grid\", { opacity: 1, duration: 1.2, ease: \"power1.out\" }, 0.8);\n        tl.to(\"#mgc-ch-h\", { opacity: 1, scaleX: 1, duration: 0.7, ease: \"power2.out\" }, 2.2);\n        tl.to(\"#mgc-ch-v\", { opacity: 1, scaleY: 1, duration: 0.7, ease: \"power2.out\" }, 2.5);\n        tl.to(\n          [\"#mgc-lock\", \"#mgc-dot\"],\n          { opacity: 1, scale: 1, duration: 0.45, ease: \"back.out(1.8)\" },\n          3.4,\n        );\n        tl.to(\"#mgc-note\", { opacity: 1, duration: 0.4 }, 4.5);\n        window.__timelines[\"map-grid-crosshair\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}
