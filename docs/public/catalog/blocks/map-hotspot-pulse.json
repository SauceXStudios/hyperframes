{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-hotspot-pulse {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mhp-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mhp-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mhp-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mhp-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mhp-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-hotspot-pulse\"\n      data-composition-id=\"map-hotspot-pulse\"\n      data-start=\"0\"\n      data-duration=\"8\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mhp-frame\">\n        <svg\n          id=\"mhp-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mhp-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mhp-hatch)\" />\n          <path\n            id=\"mhp-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mhp-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n\n          <g id=\"mhp-h1\">\n            <circle cx=\"620\" cy=\"500\" r=\"28\" fill=\"#c45c26\" opacity=\"0.35\" />\n            <circle cx=\"620\" cy=\"500\" r=\"10\" fill=\"#c45c26\" />\n          </g>\n          <g id=\"mhp-h2\">\n            <circle cx=\"920\" cy=\"420\" r=\"36\" fill=\"#c45c26\" opacity=\"0.3\" />\n            <circle cx=\"920\" cy=\"420\" r=\"10\" fill=\"#c45c26\" />\n          </g>\n          <g id=\"mhp-h3\">\n            <circle cx=\"1180\" cy=\"600\" r=\"44\" fill=\"#c45c26\" opacity=\"0.28\" />\n            <circle cx=\"1180\" cy=\"600\" r=\"10\" fill=\"#c45c26\" />\n          </g>\n          <g id=\"mhp-h4\">\n            <circle cx=\"780\" cy=\"680\" r=\"24\" fill=\"#c45c26\" opacity=\"0.32\" />\n            <circle cx=\"780\" cy=\"680\" r=\"9\" fill=\"#c45c26\" />\n          </g>\n        </svg>\n      </div>\n      <div id=\"mhp-title\" data-var-text=\"title\">Hotspots</div>\n      <div id=\"mhp-subtitle\" data-var-text=\"subtitle\">Educational cartography · heat pulse</div>\n      <div id=\"mhp-note\">Hotspot pulse · schematic heat marks</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Hotspots\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 heat pulse\";\n\n        document.getElementById(\"mhp-title\").textContent = title;\n        document.getElementById(\"mhp-subtitle\").textContent = subtitle;\n        [\"mhp-h1\", \"mhp-h2\", \"mhp-h3\", \"mhp-h4\"].forEach(function (id) {\n          document\n            .getElementById(id)\n            .querySelectorAll(\"circle\")\n            .forEach(function (c) {\n              c.setAttribute(\"fill\", accent);\n            });\n        });\n        gsap.set([\"#mhp-land\", \"#mhp-island\", \"#mhp-title\", \"#mhp-subtitle\", \"#mhp-note\"], {\n          opacity: 0,\n        });\n        gsap.set([\"#mhp-h1\", \"#mhp-h2\", \"#mhp-h3\", \"#mhp-h4\"], {\n          opacity: 0,\n          scale: 0.4,\n          transformOrigin: \"50% 50%\",\n        });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mhp-land\", { opacity: 1, duration: 0.5 }, 0);\n        tl.to(\"#mhp-island\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#mhp-title\", { opacity: 1, duration: 0.4 }, 0.15);\n        tl.to(\"#mhp-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        tl.to(\"#mhp-h1\", { opacity: 1, scale: 1, duration: 0.45, ease: \"power2.out\" }, 0.9);\n        tl.to(\"#mhp-h2\", { opacity: 1, scale: 1, duration: 0.45, ease: \"power2.out\" }, 1.3);\n        tl.to(\"#mhp-h3\", { opacity: 1, scale: 1, duration: 0.45, ease: \"power2.out\" }, 1.7);\n        tl.to(\"#mhp-h4\", { opacity: 1, scale: 1, duration: 0.45, ease: \"power2.out\" }, 2.1);\n        // seek-safe blink via timeline opacity pulses (no Math.random / rAF)\n        tl.to(\"#mhp-h1\", { opacity: 0.35, duration: 0.35, yoyo: true, repeat: 3 }, 2.8);\n        tl.to(\"#mhp-h2\", { opacity: 0.35, duration: 0.35, yoyo: true, repeat: 3 }, 3.0);\n        tl.to(\"#mhp-h3\", { opacity: 0.35, duration: 0.35, yoyo: true, repeat: 3 }, 3.2);\n        tl.to(\"#mhp-h4\", { opacity: 0.35, duration: 0.35, yoyo: true, repeat: 3 }, 3.4);\n        tl.to(\"#mhp-note\", { opacity: 1, duration: 0.4 }, 5.5);\n        window.__timelines[\"map-hotspot-pulse\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}