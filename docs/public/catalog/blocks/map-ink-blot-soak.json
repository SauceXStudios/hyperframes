{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-ink-blot-soak {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mib-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mib-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mib-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mib-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mib-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-ink-blot-soak\"\n      data-composition-id=\"map-ink-blot-soak\"\n      data-start=\"0\"\n      data-duration=\"8\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mib-frame\">\n        <svg\n          id=\"mib-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mib-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mib-hatch)\" />\n          <path\n            id=\"mib-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mib-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n\n          <ellipse id=\"mib-blot1\" cx=\"720\" cy=\"520\" rx=\"40\" ry=\"32\" fill=\"#c45c26\" />\n          <ellipse id=\"mib-blot2\" cx=\"860\" cy=\"480\" rx=\"70\" ry=\"55\" fill=\"#c45c26\" />\n          <ellipse id=\"mib-blot3\" cx=\"980\" cy=\"560\" rx=\"110\" ry=\"90\" fill=\"#c45c26\" />\n          <ellipse id=\"mib-blot4\" cx=\"1080\" cy=\"500\" rx=\"160\" ry=\"130\" fill=\"#c45c26\" />\n          <path\n            id=\"mib-region\"\n            d=\"M 620 420 C 760 380 920 400 1040 460 C 1160 520 1200 620 1100 700 C 1000 780 820 780 700 720 C 580 660 540 520 620 420 Z\"\n            fill=\"none\"\n            stroke=\"rgba(232,220,196,0.45)\"\n            stroke-width=\"2\"\n            stroke-dasharray=\"8 6\"\n          />\n        </svg>\n      </div>\n      <div id=\"mib-title\" data-var-text=\"title\">Ink Across the Province</div>\n      <div id=\"mib-subtitle\" data-var-text=\"subtitle\">Educational cartography · ink blot soak</div>\n      <div id=\"mib-note\">Blot wash soak · stylized wash only</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title =\n          typeof vars.title === \"string\" && vars.title ? vars.title : \"Ink Across the Province\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 ink blot soak\";\n\n        document.getElementById(\"mib-title\").textContent = title;\n        document.getElementById(\"mib-subtitle\").textContent = subtitle;\n        [\"mib-blot1\", \"mib-blot2\", \"mib-blot3\", \"mib-blot4\"].forEach(function (id) {\n          document.getElementById(id).setAttribute(\"fill\", accent);\n        });\n        gsap.set(\n          [\"#mib-land\", \"#mib-island\", \"#mib-region\", \"#mib-title\", \"#mib-subtitle\", \"#mib-note\"],\n          { opacity: 0 },\n        );\n        gsap.set([\"#mib-blot1\", \"#mib-blot2\", \"#mib-blot3\", \"#mib-blot4\"], {\n          scale: 0,\n          opacity: 0,\n          transformOrigin: \"50% 50%\",\n        });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mib-land\", { opacity: 1, duration: 0.5 }, 0);\n        tl.to(\"#mib-island\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#mib-title\", { opacity: 1, duration: 0.4 }, 0.15);\n        tl.to(\"#mib-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        tl.to(\"#mib-region\", { opacity: 1, duration: 0.4 }, 0.55);\n        tl.to(\"#mib-blot1\", { scale: 1, opacity: 0.55, duration: 0.7, ease: \"power2.out\" }, 1.0);\n        tl.to(\"#mib-blot2\", { scale: 1, opacity: 0.4, duration: 0.9, ease: \"power2.out\" }, 1.5);\n        tl.to(\"#mib-blot3\", { scale: 1, opacity: 0.32, duration: 1.1, ease: \"power2.out\" }, 2.2);\n        tl.to(\"#mib-blot4\", { scale: 1, opacity: 0.22, duration: 1.3, ease: \"power2.out\" }, 3.1);\n        tl.to(\"#mib-note\", { opacity: 1, duration: 0.4 }, 5.0);\n        window.__timelines[\"map-ink-blot-soak\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}