{"html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-isoline-reveal {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mir-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mir-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mir-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mir-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mir-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-isoline-reveal\"\n      data-composition-id=\"map-isoline-reveal\"\n      data-start=\"0\"\n      data-duration=\"8\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mir-frame\">\n        <svg\n          id=\"mir-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mir-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mir-hatch)\" />\n          <path\n            id=\"mir-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mir-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n          <ellipse\n            id=\"mir-iso0\"\n            cx=\"900\"\n            cy=\"560\"\n            rx=\"84.0\"\n            ry=\"60\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n            opacity=\"0.9\"\n          />\n          <ellipse\n            id=\"mir-iso1\"\n            cx=\"900\"\n            cy=\"560\"\n            rx=\"154.0\"\n            ry=\"110\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n            opacity=\"0.78\"\n          />\n          <ellipse\n            id=\"mir-iso2\"\n            cx=\"900\"\n            cy=\"560\"\n            rx=\"237.99999999999997\"\n            ry=\"170\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n            opacity=\"0.66\"\n          />\n          <ellipse\n            id=\"mir-iso3\"\n            cx=\"900\"\n            cy=\"560\"\n            rx=\"336.0\"\n            ry=\"240\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n            opacity=\"0.54\"\n          />\n          <ellipse\n            id=\"mir-iso4\"\n            cx=\"900\"\n            cy=\"560\"\n            rx=\"448.0\"\n            ry=\"320\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n            opacity=\"0.42000000000000004\"\n          />\n        </svg>\n      </div>\n      <div id=\"mir-title\" data-var-text=\"title\">Isolines</div>\n      <div id=\"mir-subtitle\" data-var-text=\"subtitle\">Educational cartography · contour reveal</div>\n      <div id=\"mir-note\">Isoline contour reveal · schematic topography</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Isolines\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 contour reveal\";\n\n        document.getElementById(\"mir-title\").textContent = title;\n        document.getElementById(\"mir-subtitle\").textContent = subtitle;\n        for (var i = 0; i < 5; i++)\n          document.getElementById(\"mir-iso\" + i).setAttribute(\"stroke\", accent);\n        gsap.set([\"#mir-land\", \"#mir-island\", \"#mir-title\", \"#mir-subtitle\", \"#mir-note\"], {\n          opacity: 0,\n        });\n        gsap.set([\"#mir-iso0\", \"#mir-iso1\", \"#mir-iso2\", \"#mir-iso3\", \"#mir-iso4\"], {\n          opacity: 0,\n          scale: 0.5,\n          transformOrigin: \"50% 50%\",\n          svgOrigin: \"900px 560px\",\n        });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mir-land\", { opacity: 1, duration: 0.5 }, 0);\n        tl.to(\"#mir-island\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#mir-title\", { opacity: 1, duration: 0.4 }, 0.15);\n        tl.to(\"#mir-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        for (var j = 0; j < 5; j++) {\n          tl.to(\n            \"#mir-iso\" + j,\n            { opacity: 0.9 - j * 0.12, scale: 1, duration: 0.7, ease: \"power2.out\" },\n            0.9 + j * 0.55,\n          );\n        }\n        tl.to(\"#mir-note\", { opacity: 1, duration: 0.4 }, 5.0);\n        window.__timelines[\"map-isoline-reveal\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}
