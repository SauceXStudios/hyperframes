{"html":"<!doctype html>\n<html lang=\"en\">\n  <head><base href=\"/public/catalog/items/map-itinerary-stops/\">\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #0a0a0a;\n        overflow: hidden;\n      }\n      #root-map-itinerary-stops {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #0a0a0a;\n        font-family: \"Helvetica Neue\", Helvetica, sans-serif;\n      }\n      #is-video {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: contain;\n        background: #000;\n      }\n      #is-frame {\n        position: absolute;\n        inset: 36px;\n        border: 1px solid rgba(232, 220, 196, 0.28);\n        pointer-events: none;\n      }\n      #is-title {\n        position: absolute;\n        left: 72px;\n        top: 56px;\n        max-width: 1600px;\n        color: rgba(245, 236, 214, 0.95);\n        font-size: 34px;\n        font-weight: 700;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.75);\n      }\n      #is-credit {\n        position: absolute;\n        left: 72px;\n        right: 72px;\n        bottom: 56px;\n        color: rgba(232, 220, 196, 0.88);\n        font-size: 16px;\n        letter-spacing: 0.06em;\n        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);\n      }\n      #is-credit-url {\n        display: block;\n        margin-top: 8px;\n        font-size: 13px;\n        letter-spacing: 0.03em;\n        color: rgba(196, 181, 154, 0.7);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-itinerary-stops\"\n      data-composition-id=\"map-itinerary-stops\"\n      data-start=\"0\"\n      data-duration=\"12.01\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <video\n        id=\"is-video\"\n        src=\"/public/catalog/assets/567e2d462319a3ea.mp4\"\n        muted\n        playsinline\n        preload=\"auto\"\n        data-start=\"0\"\n        data-duration=\"12.01\"\n        data-media-start=\"0\"\n      ></video>\n      <div id=\"is-frame\" aria-hidden=\"true\"></div>\n      <div id=\"is-title\" data-var-text=\"title\">Network Broadcasting (1934)</div>\n      <div id=\"is-credit\">\n        <span data-var-text=\"credit\">Moving Image Archive, Network Broadcasting, 1934</span>\n        <span id=\"is-credit-url\"\n          >https://www.movingimagearchive.com/sources/network-broadcasting-f8fd2623?clip=5f7f8e14-1e02-5460-99f0-4762a314904d\n          - Rights: public_domain / free to reuse</span\n        >\n      </div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n\n        var title =\n          typeof vars.title === \"string\" && vars.title ? vars.title : \"Network Broadcasting (1934)\";\n        var credit =\n          typeof vars.credit === \"string\" && vars.credit\n            ? vars.credit\n            : \"Moving Image Archive, Network Broadcasting, 1934\";\n\n        document.getElementById(\"is-title\").textContent = title;\n        document.querySelector('#is-credit [data-var-text=\"credit\"]').textContent = credit;\n\n        var tl = gsap.timeline({ paused: true });\n        tl.fromTo(\n          \"#is-title\",\n          { opacity: 0 },\n          { opacity: 1, duration: 0.6, ease: \"power1.out\" },\n          0,\n        );\n        tl.fromTo(\n          \"#is-credit\",\n          { opacity: 0 },\n          { opacity: 1, duration: 0.6, ease: \"power1.out\" },\n          0.15,\n        );\n        tl.to({}, { duration: Math.max(0.01, 12.01 - 0.75) });\n\n        window.__timelines[\"map-itinerary-stops\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}