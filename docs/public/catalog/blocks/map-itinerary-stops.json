{"html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-itinerary-stops {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mis-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mis-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mis-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mis-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mis-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-itinerary-stops\"\n      data-composition-id=\"map-itinerary-stops\"\n      data-start=\"0\"\n      data-duration=\"8\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mis-frame\">\n        <svg\n          id=\"mis-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mis-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mis-hatch)\" />\n          <path\n            id=\"mis-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mis-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n\n          <path\n            id=\"mis-path\"\n            d=\"M 420 620 C 560 540 700 500 840 480 C 980 460 1100 500 1220 540 C 1320 570 1400 520 1500 460\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"3\"\n            stroke-linecap=\"round\"\n          />\n          <g id=\"mis-s1\">\n            <circle cx=\"420\" cy=\"620\" r=\"18\" fill=\"#c45c26\" />\n            <text\n              id=\"mis-t1\"\n              x=\"420\"\n              y=\"626\"\n              text-anchor=\"middle\"\n              fill=\"#1a1714\"\n              font-size=\"18\"\n              font-family=\"Georgia, serif\"\n              font-weight=\"700\"\n            >\n              1\n            </text>\n          </g>\n          <g id=\"mis-s2\">\n            <circle cx=\"840\" cy=\"480\" r=\"18\" fill=\"#c45c26\" />\n            <text\n              id=\"mis-t2\"\n              x=\"840\"\n              y=\"486\"\n              text-anchor=\"middle\"\n              fill=\"#1a1714\"\n              font-size=\"18\"\n              font-family=\"Georgia, serif\"\n              font-weight=\"700\"\n            >\n              2\n            </text>\n          </g>\n          <g id=\"mis-s3\">\n            <circle cx=\"1220\" cy=\"540\" r=\"18\" fill=\"#c45c26\" />\n            <text\n              id=\"mis-t3\"\n              x=\"1220\"\n              y=\"546\"\n              text-anchor=\"middle\"\n              fill=\"#1a1714\"\n              font-size=\"18\"\n              font-family=\"Georgia, serif\"\n              font-weight=\"700\"\n            >\n              3\n            </text>\n          </g>\n          <g id=\"mis-s4\">\n            <circle cx=\"1500\" cy=\"460\" r=\"18\" fill=\"#c45c26\" />\n            <text\n              id=\"mis-t4\"\n              x=\"1500\"\n              y=\"466\"\n              text-anchor=\"middle\"\n              fill=\"#1a1714\"\n              font-size=\"18\"\n              font-family=\"Georgia, serif\"\n              font-weight=\"700\"\n            >\n              4\n            </text>\n          </g>\n        </svg>\n      </div>\n      <div id=\"mis-title\" data-var-text=\"title\">The Itinerary</div>\n      <div id=\"mis-subtitle\" data-var-text=\"subtitle\">\n        Educational cartography · multi-stop route\n      </div>\n      <div id=\"mis-note\">Numbered stops along a schematic itinerary</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"The Itinerary\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 multi-stop route\";\n        var labelA = typeof vars.labelA === \"string\" && vars.labelA ? vars.labelA : \"1\";\n        var labelB = typeof vars.labelB === \"string\" && vars.labelB ? vars.labelB : \"2\";\n        var labelC = typeof vars.labelC === \"string\" && vars.labelC ? vars.labelC : \"3\";\n        var labelD = typeof vars.labelD === \"string\" && vars.labelD ? vars.labelD : \"4\";\n\n        document.getElementById(\"mis-title\").textContent = title;\n        document.getElementById(\"mis-subtitle\").textContent = subtitle;\n        document.getElementById(\"mis-t1\").textContent = labelA;\n        document.getElementById(\"mis-t2\").textContent = labelB;\n        document.getElementById(\"mis-t3\").textContent = labelC;\n        document.getElementById(\"mis-t4\").textContent = labelD;\n        var path = document.getElementById(\"mis-path\");\n        path.setAttribute(\"stroke\", accent);\n        [\"mis-s1\", \"mis-s2\", \"mis-s3\", \"mis-s4\"].forEach(function (id) {\n          document.getElementById(id).querySelector(\"circle\").setAttribute(\"fill\", accent);\n        });\n        var len = path.getTotalLength();\n        gsap.set(path, { strokeDasharray: len, strokeDashoffset: len });\n        gsap.set([\"#mis-land\", \"#mis-island\", \"#mis-title\", \"#mis-subtitle\", \"#mis-note\"], {\n          opacity: 0,\n        });\n        gsap.set([\"#mis-s1\", \"#mis-s2\", \"#mis-s3\", \"#mis-s4\"], {\n          opacity: 0,\n          scale: 0,\n          transformOrigin: \"50% 50%\",\n        });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mis-land\", { opacity: 1, duration: 0.5 }, 0);\n        tl.to(\"#mis-island\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#mis-title\", { opacity: 1, duration: 0.4 }, 0.15);\n        tl.to(\"#mis-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        tl.to(\"#mis-s1\", { opacity: 1, scale: 1, duration: 0.35, ease: \"back.out(1.8)\" }, 0.8);\n        tl.to(path, { strokeDashoffset: len * 0.72, duration: 1.0, ease: \"power1.inOut\" }, 1.2);\n        tl.to(\"#mis-s2\", { opacity: 1, scale: 1, duration: 0.35, ease: \"back.out(1.8)\" }, 2.1);\n        tl.to(path, { strokeDashoffset: len * 0.35, duration: 1.0, ease: \"power1.inOut\" }, 2.4);\n        tl.to(\"#mis-s3\", { opacity: 1, scale: 1, duration: 0.35, ease: \"back.out(1.8)\" }, 3.3);\n        tl.to(path, { strokeDashoffset: 0, duration: 1.0, ease: \"power1.inOut\" }, 3.6);\n        tl.to(\"#mis-s4\", { opacity: 1, scale: 1, duration: 0.35, ease: \"back.out(1.8)\" }, 4.5);\n        tl.to(\"#mis-note\", { opacity: 1, duration: 0.4 }, 5.5);\n        window.__timelines[\"map-itinerary-stops\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}
