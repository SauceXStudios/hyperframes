{"html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-legend-build {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mlb-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mlb-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mlb-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mlb-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mlb-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-legend-build\"\n      data-composition-id=\"map-legend-build\"\n      data-start=\"0\"\n      data-duration=\"7\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mlb-frame\">\n        <svg\n          id=\"mlb-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mlb-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mlb-hatch)\" />\n          <path\n            id=\"mlb-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mlb-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n\n          <g id=\"mlb-legend\" transform=\"translate(1380 360)\">\n            <rect\n              id=\"mlb-panel\"\n              x=\"0\"\n              y=\"0\"\n              width=\"280\"\n              height=\"280\"\n              fill=\"#1a1714\"\n              stroke=\"rgba(196,181,154,0.35)\"\n              stroke-width=\"1.5\"\n            />\n            <g id=\"mlb-row1\">\n              <rect x=\"24\" y=\"36\" width=\"28\" height=\"16\" fill=\"#c45c26\" opacity=\"0.7\" />\n              <text\n                x=\"68\"\n                y=\"50\"\n                fill=\"rgba(232,220,196,0.85)\"\n                font-size=\"18\"\n                font-family=\"Georgia, serif\"\n              >\n                Territory\n              </text>\n            </g>\n            <g id=\"mlb-row2\">\n              <line\n                x1=\"24\"\n                y1=\"92\"\n                x2=\"52\"\n                y2=\"92\"\n                stroke=\"#c45c26\"\n                stroke-width=\"3\"\n                stroke-dasharray=\"4 6\"\n              />\n              <text\n                x=\"68\"\n                y=\"98\"\n                fill=\"rgba(232,220,196,0.85)\"\n                font-size=\"18\"\n                font-family=\"Georgia, serif\"\n              >\n                Route\n              </text>\n            </g>\n            <g id=\"mlb-row3\">\n              <circle cx=\"38\" cy=\"148\" r=\"8\" fill=\"#c45c26\" />\n              <text\n                x=\"68\"\n                y=\"154\"\n                fill=\"rgba(232,220,196,0.85)\"\n                font-size=\"18\"\n                font-family=\"Georgia, serif\"\n              >\n                City\n              </text>\n            </g>\n            <g id=\"mlb-row4\">\n              <polygon points=\"30,198 46,208 30,218\" fill=\"#c45c26\" />\n              <text\n                x=\"68\"\n                y=\"214\"\n                fill=\"rgba(232,220,196,0.85)\"\n                font-size=\"18\"\n                font-family=\"Georgia, serif\"\n              >\n                Advance\n              </text>\n            </g>\n          </g>\n          <path\n            id=\"mlb-sample\"\n            d=\"M 480 560 C 620 500 760 520 900 500\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"3\"\n            stroke-dasharray=\"4 6\"\n          />\n          <circle id=\"mlb-city\" cx=\"900\" cy=\"500\" r=\"10\" fill=\"#c45c26\" />\n        </svg>\n      </div>\n      <div id=\"mlb-title\" data-var-text=\"title\">Legend Build</div>\n      <div id=\"mlb-subtitle\" data-var-text=\"subtitle\">\n        Educational cartography · legend assemble\n      </div>\n      <div id=\"mlb-note\">Legend assemble · keyed to schematic symbols</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Legend Build\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 legend assemble\";\n\n        document.getElementById(\"mlb-title\").textContent = title;\n        document.getElementById(\"mlb-subtitle\").textContent = subtitle;\n        document.querySelector(\"#mlb-row1 rect\").setAttribute(\"fill\", accent);\n        document.querySelector(\"#mlb-row2 line\").setAttribute(\"stroke\", accent);\n        document.querySelector(\"#mlb-row3 circle\").setAttribute(\"fill\", accent);\n        document.querySelector(\"#mlb-row4 polygon\").setAttribute(\"fill\", accent);\n        document.getElementById(\"mlb-sample\").setAttribute(\"stroke\", accent);\n        document.getElementById(\"mlb-city\").setAttribute(\"fill\", accent);\n        gsap.set(\n          [\n            \"#mlb-land\",\n            \"#mlb-island\",\n            \"#mlb-title\",\n            \"#mlb-subtitle\",\n            \"#mlb-note\",\n            \"#mlb-sample\",\n            \"#mlb-city\",\n          ],\n          { opacity: 0 },\n        );\n        gsap.set(\"#mlb-panel\", {\n          opacity: 0,\n          scaleY: 0,\n          transformOrigin: \"50% 0%\",\n          svgOrigin: \"1520px 360px\",\n        });\n        gsap.set([\"#mlb-row1\", \"#mlb-row2\", \"#mlb-row3\", \"#mlb-row4\"], { opacity: 0, x: 20 });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mlb-land\", { opacity: 1, duration: 0.5 }, 0);\n        tl.to(\"#mlb-island\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#mlb-title\", { opacity: 1, duration: 0.4 }, 0.15);\n        tl.to(\"#mlb-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        tl.to(\"#mlb-panel\", { opacity: 1, scaleY: 1, duration: 0.55, ease: \"power2.out\" }, 0.9);\n        tl.to(\"#mlb-row1\", { opacity: 1, x: 0, duration: 0.35 }, 1.4);\n        tl.to(\"#mlb-row2\", { opacity: 1, x: 0, duration: 0.35 }, 1.9);\n        tl.to(\"#mlb-sample\", { opacity: 1, duration: 0.4 }, 2.1);\n        tl.to(\"#mlb-row3\", { opacity: 1, x: 0, duration: 0.35 }, 2.4);\n        tl.to(\"#mlb-city\", { opacity: 1, duration: 0.3 }, 2.6);\n        tl.to(\"#mlb-row4\", { opacity: 1, x: 0, duration: 0.35 }, 2.9);\n        tl.to(\"#mlb-note\", { opacity: 1, duration: 0.4 }, 4.2);\n        window.__timelines[\"map-legend-build\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}
