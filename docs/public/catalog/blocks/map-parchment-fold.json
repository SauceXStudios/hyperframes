{"html":"<!doctype html>\n<html lang=\"en\">\n  <head><base href=\"/public/catalog/items/map-parchment-fold/\">\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #0a0a0a;\n        overflow: hidden;\n      }\n      #root-map-parchment-fold {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #0a0a0a;\n        font-family: \"Helvetica Neue\", Helvetica, sans-serif;\n      }\n      #pf-video {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: contain;\n        background: #000;\n      }\n      #pf-frame {\n        position: absolute;\n        inset: 36px;\n        border: 1px solid rgba(232, 220, 196, 0.28);\n        pointer-events: none;\n      }\n      #pf-title {\n        position: absolute;\n        left: 72px;\n        top: 56px;\n        max-width: 1400px;\n        color: rgba(245, 236, 214, 0.95);\n        font-size: 36px;\n        font-weight: 700;\n        letter-spacing: 0.14em;\n        text-transform: uppercase;\n        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.75);\n      }\n      #pf-credit {\n        position: absolute;\n        left: 72px;\n        right: 72px;\n        bottom: 56px;\n        color: rgba(232, 220, 196, 0.88);\n        font-size: 18px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);\n      }\n      #pf-credit-url {\n        display: block;\n        margin-top: 8px;\n        font-size: 14px;\n        letter-spacing: 0.04em;\n        text-transform: none;\n        color: rgba(196, 181, 154, 0.7);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-parchment-fold\"\n      data-composition-id=\"map-parchment-fold\"\n      data-start=\"0\"\n      data-duration=\"12.01\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <video\n        id=\"pf-video\"\n        src=\"/public/catalog/assets/88a5386427d80dd6.mp4\"\n        muted\n        playsinline\n        preload=\"auto\"\n        data-start=\"0\"\n        data-duration=\"12.01\"\n        data-media-start=\"0\"\n      ></video>\n      <div id=\"pf-frame\" aria-hidden=\"true\"></div>\n      <div id=\"pf-title\" data-var-text=\"title\">Archival Map - Parchment Fold</div>\n      <div id=\"pf-credit\">\n        <span data-var-text=\"credit\"\n          >Footage: Moving Image Archive | AOPA-ASF: Thunderstorms and the ATC</span\n        >\n        <span id=\"pf-credit-url\"\n          >movingimagearchive.com/collection/animated-maps - public domain / free to reuse</span\n        >\n      </div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n\n        var title =\n          typeof vars.title === \"string\" && vars.title\n            ? vars.title\n            : \"Archival Map - Parchment Fold\";\n        var credit =\n          typeof vars.credit === \"string\" && vars.credit\n            ? vars.credit\n            : \"Footage: Moving Image Archive | AOPA-ASF: Thunderstorms and the ATC\";\n\n        document.getElementById(\"pf-title\").textContent = title;\n        document.querySelector('#pf-credit [data-var-text=\"credit\"]').textContent = credit;\n\n        var tl = gsap.timeline({ paused: true });\n        // Credit/title hold - HyperFrames media runtime seeks the video via data-start\n        tl.fromTo(\n          \"#pf-title\",\n          { opacity: 0 },\n          { opacity: 1, duration: 0.6, ease: \"power1.out\" },\n          0,\n        );\n        tl.fromTo(\n          \"#pf-credit\",\n          { opacity: 0 },\n          { opacity: 1, duration: 0.6, ease: \"power1.out\" },\n          0.15,\n        );\n        tl.to({}, { duration: Math.max(0.01, 12.01 - 0.75) });\n\n        window.__timelines[\"map-parchment-fold\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}