{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-parchment-fold {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mpf-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mpf-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mpf-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mpf-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mpf-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-parchment-fold\"\n      data-composition-id=\"map-parchment-fold\"\n      data-start=\"0\"\n      data-duration=\"8\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mpf-frame\">\n        <svg\n          id=\"mpf-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mpf-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#c4b59a\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mpf-hatch)\" opacity=\"0.5\" />\n          <path\n            id=\"mpf-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(90,70,40,0.28)\"\n            stroke=\"rgba(90,70,40,0.55)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mpf-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(90,70,40,0.2)\"\n            stroke=\"rgba(90,70,40,0.4)\"\n            stroke-width=\"1.5\"\n          />\n          <path\n            id=\"mpf-route\"\n            d=\"M 480 560 C 680 500 900 480 1120 520 C 1280 548 1400 500 1520 470\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"3\"\n            stroke-linecap=\"round\"\n          />\n          <line\n            id=\"mpf-crease\"\n            x1=\"960\"\n            y1=\"80\"\n            x2=\"960\"\n            y2=\"1000\"\n            stroke=\"rgba(90,70,40,0.25)\"\n            stroke-width=\"2\"\n            stroke-dasharray=\"6 8\"\n          />\n        </svg>\n      </div>\n      <div id=\"mpf-title\" data-var-text=\"title\">Parchment Chart</div>\n      <div id=\"mpf-subtitle\" data-var-text=\"subtitle\">Educational cartography · paper fold</div>\n      <div id=\"mpf-note\">Parchment unfold · paper-map aesthetic</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Parchment Chart\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 paper fold\";\n\n        document.getElementById(\"mpf-title\").textContent = title;\n        document.getElementById(\"mpf-subtitle\").textContent = subtitle;\n        document.getElementById(\"mpf-route\").setAttribute(\"stroke\", accent);\n        var route = document.getElementById(\"mpf-route\");\n        var len = route.getTotalLength();\n        gsap.set(route, { strokeDasharray: len, strokeDashoffset: len });\n        gsap.set(\n          [\"#mpf-land\", \"#mpf-island\", \"#mpf-title\", \"#mpf-subtitle\", \"#mpf-note\", \"#mpf-crease\"],\n          { opacity: 0 },\n        );\n        gsap.set(\"#mpf-frame\", { scaleX: 0.08, transformOrigin: \"50% 50%\" });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mpf-frame\", { scaleX: 1, duration: 1.4, ease: \"power2.out\" }, 0);\n        tl.to(\"#mpf-land\", { opacity: 1, duration: 0.5 }, 1.0);\n        tl.to(\"#mpf-island\", { opacity: 1, duration: 0.4 }, 1.1);\n        tl.to(\"#mpf-crease\", { opacity: 1, duration: 0.4 }, 1.2);\n        tl.to(\"#mpf-title\", { opacity: 1, duration: 0.4 }, 1.3);\n        tl.to(\"#mpf-subtitle\", { opacity: 1, duration: 0.35 }, 1.5);\n        tl.to(route, { strokeDashoffset: 0, duration: 2.8, ease: \"power1.inOut\" }, 2.0);\n        tl.to(\"#mpf-note\", { opacity: 1, duration: 0.4 }, 5.2);\n        window.__timelines[\"map-parchment-fold\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}