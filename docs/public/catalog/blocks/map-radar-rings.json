{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head><base href=\"/public/catalog/items/map-radar-rings/\">\n<meta charset=\"utf-8\"/>\n<title>radar-rings - measured reverse (rings-only) soft-ink pass8j-closer</title>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n<style>\n  html,body{margin:0;background:#111;overflow:hidden}\n  #stage{width:1920px;height:1080px;position:relative;background:#B8B8B8}\n  #content{position:absolute;left:240px;top:0;width:1440px;height:1080px;overflow:hidden;background:#000}\n  #mapRoot{position:absolute;inset:0;transform-origin:0 0;transform:scale(4.5);width:320px;height:240px}\n  #plate{position:absolute;left:0;top:0;width:320px;height:240px;display:block}\n  /* P1: uniform film-black plate mask - kills structured ghost map at t0 */\n  #fade{position:absolute;inset:0;background:#0F0F0F;opacity:1;pointer-events:none;z-index:5}\n  #rings{\n    position:absolute;left:0;top:0;width:320px;height:240px;\n    overflow:visible;pointer-events:none;\n    /* P0: normal blend - kill screen additive neon stacking on overlaps */\n    mix-blend-mode:normal;\n  }\n  /* Soft-ink - pass8j-closer: stroke 1.48; single σ0.62; op 0.50; NYC op_scale; thin luminous not fog */\n  .ring{\n    fill:none;stroke:#FFFFFF;stroke-width:1.48;opacity:0;\n    stroke-linecap:round;stroke-linejoin:round;\n    filter:url(#filmBloom);\n  }\n</style>\n</head>\n<body>\n<div\n  id=\"root-map-radar-rings\"\n  data-composition-id=\"map-radar-rings\"\n  data-start=\"0\"\n  data-duration=\"3.5\"\n  data-width=\"1920\"\n  data-height=\"1080\"\n>\n<div id=\"stage\">\n  <div id=\"content\">\n    <div id=\"mapRoot\">\n      <img id=\"plate\" src=\"/public/catalog/assets/d93f4e567e2f6363.png\" width=\"320\" height=\"240\" alt=\"measured film hold plate\"/>\n      <svg id=\"rings\" viewBox=\"0 0 320 240\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <filter id=\"filmBloom\" filterUnits=\"userSpaceOnUse\" x=\"-60\" y=\"-60\" width=\"440\" height=\"360\"\n                  color-interpolation-filters=\"sRGB\">\n            <!-- pass8j-closer: single soft-ink σ0.62 - thin luminous stroke, no multi-σ/screen -->\n            <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"0.62\" result=\"soft\"/>\n            <feMerge>\n              <feMergeNode in=\"soft\"/>\n            </feMerge>\n          </filter>\n        </defs>\n      </svg>\n    </div>\n    <div id=\"fade\"></div>\n  </div>\n</div>\n<div id=\"mrr-credit\" style=\"position:absolute;left:260px;bottom:28px;color:rgba(0,0,0,0.4);font:13px/1.3 ui-monospace,monospace;letter-spacing:0.04em;text-transform:uppercase;z-index:6\">\n  Moving Image Archive, Network Broadcasting, 1934 - code recreation - not affiliated\n</div>\n<script>\nconst DATA = {\"hubs\":[{\"id\":\"nyc\",\"x\":281,\"y\":82,\"onset_rel\":1.1,\"r_max\":17,\"expand_s\":3.15,\"p\":\"measured\",\"op_scale\":1.7},{\"id\":\"chicago\",\"x\":221,\"y\":94,\"onset_rel\":1.12,\"r_max\":17,\"expand_s\":3.15,\"p\":\"measured\"},{\"id\":\"denver\",\"x\":109,\"y\":101,\"onset_rel\":1.06,\"r_max\":17,\"expand_s\":3.15,\"op_scale\":1.55,\"p\":\"measured\"},{\"id\":\"kansas_city\",\"x\":167,\"y\":103,\"onset_rel\":1.08,\"r_max\":17,\"expand_s\":3.15,\"op_scale\":1.7,\"p\":\"measured\"},{\"id\":\"nashville_area\",\"x\":220,\"y\":138,\"onset_rel\":1.2,\"r_max\":17,\"expand_s\":3.15,\"p\":\"measured\"},{\"id\":\"atlanta\",\"x\":233,\"y\":140,\"onset_rel\":1.24,\"r_max\":17,\"expand_s\":3.15,\"p\":\"measured\"}],\"ring\":{\"rings_per_pulse\":2,\"pulse_interval_s\":0.75,\"expand_duration_s\":3.15,\"r_max_px\":17,\"stroke_px\":1.48,\"intra_pulse_stagger_s\":0.28,\"color\":\"#FFFFFF\",\"opacity\":[0.5,0.0],\"ease\":\"mildOut\",\"opacity_ease\":\"power1.in\",\"max_pulses\":2,\"p\":\"measured\",\"opacity_hold_frac\":0.65,\"bloom\":{\"filter\":\"filmBloom\",\"std_wide\":0,\"std_mid\":0,\"std_tight\":0.62,\"wide_weight\":0,\"mid_weight\":0,\"tight_weight\":1.0,\"blend\":\"normal\",\"target_fwhm_px\":1.6,\"note\":\"pass8j-closer: stroke 1.48 + single soft-ink sigma0.62; op 0.50; NYC op_scale 1.70 (NE plate punch); KEEP normal; no multi-sigma/screen\"}},\"fade\":{\"black_overlay_start\":1.0,\"black_overlay_end\":0.0,\"duration_s\":1.15,\"ease\":\"power2.in\",\"color\":\"#0F0F0F\",\"p\":\"measured\",\"note\":\"pass8i KEEP: stronger solid-to-fade hold power2.in over 1.15s; early SBS cols stay dark; ghost-dead t0\"},\"duration\":3.5,\"ease_r_pow\":1.1};\nfunction main(){\n  window.gsap = gsap;\n  const svg = document.getElementById('rings');\n  const fade = document.getElementById('fade');\n  const RINGS_PER = DATA.ring.rings_per_pulse;\n  const INTERVAL = DATA.ring.pulse_interval_s;\n  const EXPAND_DEFAULT = DATA.ring.expand_duration_s;\n  const RMAX_DEFAULT = DATA.ring.r_max_px;\n  const STAGGER = DATA.ring.intra_pulse_stagger_s || 0.30;\n  const OP0 = DATA.ring.opacity[0];\n  const HOLD = DATA.ring.opacity_hold_frac || 0.55;\n  const MAX_PULSES = DATA.ring.max_pulses || 2;\n  const DUR = DATA.duration;\n  const FADE = DATA.fade;\n  const mildOut = (t) => 1 - Math.pow(1 - t, (DATA.ease_r_pow != null ? DATA.ease_r_pow : 1.55));\n  const EASE_R = mildOut;\n  const EASE_OP = DATA.ring.opacity_ease || 'power1.in';\n  const STROKE = DATA.ring.stroke_px;\n\n  const hubPulsePlan = [];\n  for (const h of DATA.hubs) {\n    const rMax = (h.r_max != null) ? h.r_max : RMAX_DEFAULT;\n    const expand = (h.expand_s != null) ? h.expand_s : EXPAND_DEFAULT;\n    const opPeak = OP0 * (h.op_scale != null ? h.op_scale : 1);\n    const pulses = [];\n    for (let p = 0; p < MAX_PULSES; p++) {\n      const start = h.onset_rel + p * INTERVAL;\n      if (start >= DUR - 0.2) break;\n      const group = [];\n      for (let k = 0; k < RINGS_PER; k++) {\n        const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');\n        c.setAttribute('class', 'ring');\n        c.setAttribute('cx', h.x);\n        c.setAttribute('cy', h.y);\n        c.setAttribute('r', 0);\n        c.setAttribute('stroke-width', STROKE);\n        svg.appendChild(c);\n        group.push(c);\n      }\n      pulses.push({ start, els: group, rMax, expand, opPeak });\n    }\n    hubPulsePlan.push({ hub: h, pulses });\n  }\n\n  const tl = gsap.timeline({ paused: true });\n  tl.set(fade, { opacity: FADE.black_overlay_start }, 0);\n  // stronger solid hold (power2.in) so early SBS cols stay dark/uniform\n  tl.to(fade, { opacity: FADE.black_overlay_end, duration: FADE.duration_s, ease: (FADE.ease || 'power2.in') }, 0);\n\n  for (const { pulses } of hubPulsePlan) {\n    for (const pulse of pulses) {\n      pulse.els.forEach((el, k) => {\n        const delay = pulse.start + k * STAGGER;\n        if (delay >= DUR) return;\n        const holdT = pulse.expand * HOLD;\n        const fadeT = pulse.expand * (1 - HOLD);\n        const riseT = Math.min(0.14, holdT * 0.20);\n        const opPeak = pulse.opPeak;\n\n        tl.set(el, { attr: { r: 0 }, opacity: 0 }, delay);\n        tl.to(el, { attr: { r: pulse.rMax }, duration: pulse.expand, ease: EASE_R }, delay);\n        tl.to(el, { opacity: opPeak, duration: riseT, ease: 'sine.out' }, delay);\n        tl.to(el, { opacity: 0, duration: fadeT, ease: EASE_OP }, delay + holdT);\n      });\n    }\n  }\n\n  window.__radarTimeline = tl;\n  window.__timelines = window.__timelines || {};\n  window.__timelines[\"map-radar-rings\"] = tl;\n  window.__duration = DUR;\n  window.__ready = true;\n  window.__bloom = DATA.ring.bloom;\n  window.__hubs = DATA.hubs.map(h => h.id);\n  console.log('ready hubs', DATA.hubs.map(h=>h.id), 'dur', DUR, 'r_max', RMAX_DEFAULT,\n              'hold', HOLD, 'bloom', DATA.ring.bloom, 'op', OP0, 'fade0', FADE.black_overlay_start,\n              'stroke', STROKE, 'fadeEase', FADE.ease, 'easePow', DATA.ease_r_pow);\n}\nmain();\n</script>\n</div>\n</body>\n</html>\n"}