{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-radar-rings {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mrr-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mrr-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mrr-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mrr-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mrr-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-radar-rings\"\n      data-composition-id=\"map-radar-rings\"\n      data-start=\"0\"\n      data-duration=\"9\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mrr-frame\">\n        <svg\n          id=\"mrr-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mrr-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mrr-hatch)\" />\n          <path\n            id=\"mrr-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mrr-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n\n          <circle\n            id=\"mrr-r1\"\n            cx=\"900\"\n            cy=\"540\"\n            r=\"80\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n          />\n          <circle\n            id=\"mrr-r2\"\n            cx=\"900\"\n            cy=\"540\"\n            r=\"160\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n          />\n          <circle\n            id=\"mrr-r3\"\n            cx=\"900\"\n            cy=\"540\"\n            r=\"240\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n          />\n          <circle\n            id=\"mrr-r4\"\n            cx=\"900\"\n            cy=\"540\"\n            r=\"320\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"1.5\"\n            opacity=\"0.7\"\n          />\n          <circle id=\"mrr-core\" cx=\"900\" cy=\"540\" r=\"10\" fill=\"#c45c26\" />\n          <line\n            id=\"mrr-sweep\"\n            x1=\"900\"\n            y1=\"540\"\n            x2=\"900\"\n            y2=\"220\"\n            stroke=\"#e8dcc4\"\n            stroke-width=\"2\"\n            opacity=\"0.65\"\n          />\n        </svg>\n      </div>\n      <div id=\"mrr-title\" data-var-text=\"title\">Range Rings</div>\n      <div id=\"mrr-subtitle\" data-var-text=\"subtitle\">Educational cartography · radar rings</div>\n      <div id=\"mrr-note\">Range rings · schematic sweep only</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Range Rings\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 radar rings\";\n\n        document.getElementById(\"mrr-title\").textContent = title;\n        document.getElementById(\"mrr-subtitle\").textContent = subtitle;\n        [\"mrr-r1\", \"mrr-r2\", \"mrr-r3\", \"mrr-r4\"].forEach(function (id) {\n          document.getElementById(id).setAttribute(\"stroke\", accent);\n        });\n        document.getElementById(\"mrr-core\").setAttribute(\"fill\", accent);\n        gsap.set(\n          [\n            \"#mrr-land\",\n            \"#mrr-island\",\n            \"#mrr-title\",\n            \"#mrr-subtitle\",\n            \"#mrr-note\",\n            \"#mrr-core\",\n            \"#mrr-sweep\",\n          ],\n          { opacity: 0 },\n        );\n        gsap.set([\"#mrr-r1\", \"#mrr-r2\", \"#mrr-r3\", \"#mrr-r4\"], {\n          scale: 0.2,\n          opacity: 0,\n          transformOrigin: \"50% 50%\",\n          svgOrigin: \"900px 540px\",\n        });\n        gsap.set(\"#mrr-sweep\", {\n          transformOrigin: \"900px 540px\",\n          rotation: 0,\n          svgOrigin: \"900px 540px\",\n        });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mrr-land\", { opacity: 1, duration: 0.5 }, 0);\n        tl.to(\"#mrr-island\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#mrr-title\", { opacity: 1, duration: 0.4 }, 0.15);\n        tl.to(\"#mrr-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        tl.to(\"#mrr-core\", { opacity: 1, duration: 0.25 }, 0.7);\n        tl.to(\"#mrr-r1\", { scale: 1, opacity: 1, duration: 0.6, ease: \"power2.out\" }, 1.0);\n        tl.to(\"#mrr-r2\", { scale: 1, opacity: 1, duration: 0.7, ease: \"power2.out\" }, 1.5);\n        tl.to(\"#mrr-r3\", { scale: 1, opacity: 1, duration: 0.8, ease: \"power2.out\" }, 2.1);\n        tl.to(\"#mrr-r4\", { scale: 1, opacity: 0.7, duration: 0.9, ease: \"power2.out\" }, 2.8);\n        tl.to(\"#mrr-sweep\", { opacity: 0.65, duration: 0.3 }, 3.4);\n        tl.to(\"#mrr-sweep\", { rotation: 360, duration: 4.0, ease: \"none\" }, 3.5);\n        tl.to(\"#mrr-note\", { opacity: 1, duration: 0.4 }, 6.0);\n        window.__timelines[\"map-radar-rings\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}