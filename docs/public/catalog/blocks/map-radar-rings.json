{"html":"<!doctype html>\n<html lang=\"en\">\n  <head><base href=\"/public/catalog/items/map-radar-rings/\">\n    <meta charset=\"utf-8\" />\n    <title>radar-rings - measured reverse (rings-only) soft-ink pass8j-closer</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      html,\n      body {\n        margin: 0;\n        background: #111;\n        overflow: hidden;\n      }\n      #stage {\n        width: 1920px;\n        height: 1080px;\n        position: relative;\n        background: #b8b8b8;\n      }\n      #content {\n        position: absolute;\n        left: 240px;\n        top: 0;\n        width: 1440px;\n        height: 1080px;\n        overflow: hidden;\n        background: #000;\n      }\n      #mapRoot {\n        position: absolute;\n        inset: 0;\n        transform-origin: 0 0;\n        transform: scale(4.5);\n        width: 320px;\n        height: 240px;\n      }\n      #plate {\n        position: absolute;\n        left: 0;\n        top: 0;\n        width: 320px;\n        height: 240px;\n        display: block;\n      }\n      /* P1: uniform film-black plate mask - kills structured ghost map at t0 */\n      #fade {\n        position: absolute;\n        inset: 0;\n        background: #0f0f0f;\n        opacity: 1;\n        pointer-events: none;\n        z-index: 5;\n      }\n      #rings {\n        position: absolute;\n        left: 0;\n        top: 0;\n        width: 320px;\n        height: 240px;\n        overflow: visible;\n        pointer-events: none;\n        /* P0: normal blend - kill screen additive neon stacking on overlaps */\n        mix-blend-mode: normal;\n      }\n      /* Soft-ink - pass8j-closer: stroke 1.48; single σ0.62; op 0.50; NYC op_scale; thin luminous not fog */\n      .ring {\n        fill: none;\n        stroke: #ffffff;\n        stroke-width: 1.48;\n        opacity: 0;\n        stroke-linecap: round;\n        stroke-linejoin: round;\n        filter: url(#filmBloom);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-radar-rings\"\n      data-composition-id=\"map-radar-rings\"\n      data-start=\"0\"\n      data-duration=\"3.5\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"stage\">\n        <div id=\"content\">\n          <div id=\"mapRoot\">\n            <img\n              id=\"plate\"\n              src=\"/public/catalog/assets/d93f4e567e2f6363.png\"\n              width=\"320\"\n              height=\"240\"\n              alt=\"measured film hold plate\"\n            />\n            <svg id=\"rings\" viewBox=\"0 0 320 240\" xmlns=\"http://www.w3.org/2000/svg\">\n              <defs>\n                <filter\n                  id=\"filmBloom\"\n                  filterUnits=\"userSpaceOnUse\"\n                  x=\"-60\"\n                  y=\"-60\"\n                  width=\"440\"\n                  height=\"360\"\n                  color-interpolation-filters=\"sRGB\"\n                >\n                  <!-- pass8j-closer: single soft-ink σ0.62 - thin luminous stroke, no multi-σ/screen -->\n                  <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"0.62\" result=\"soft\" />\n                  <feMerge>\n                    <feMergeNode in=\"soft\" />\n                  </feMerge>\n                </filter>\n              </defs>\n            </svg>\n          </div>\n          <div id=\"fade\"></div>\n        </div>\n      </div>\n      <div\n        id=\"mrr-credit\"\n        style=\"\n          position: absolute;\n          left: 260px;\n          bottom: 28px;\n          color: rgba(0, 0, 0, 0.4);\n          font:\n            13px/1.3 ui-monospace,\n            monospace;\n          letter-spacing: 0.04em;\n          text-transform: uppercase;\n          z-index: 6;\n        \"\n      >\n        Moving Image Archive, Network Broadcasting, 1934 - code recreation - not affiliated\n      </div>\n      <script>\n        const DATA = {\n          hubs: [\n            {\n              id: \"nyc\",\n              x: 281,\n              y: 82,\n              onset_rel: 1.1,\n              r_max: 17,\n              expand_s: 3.15,\n              p: \"measured\",\n              op_scale: 1.7,\n            },\n            {\n              id: \"chicago\",\n              x: 221,\n              y: 94,\n              onset_rel: 1.12,\n              r_max: 17,\n              expand_s: 3.15,\n              p: \"measured\",\n            },\n            {\n              id: \"denver\",\n              x: 109,\n              y: 101,\n              onset_rel: 1.06,\n              r_max: 17,\n              expand_s: 3.15,\n              op_scale: 1.55,\n              p: \"measured\",\n            },\n            {\n              id: \"kansas_city\",\n              x: 167,\n              y: 103,\n              onset_rel: 1.08,\n              r_max: 17,\n              expand_s: 3.15,\n              op_scale: 1.7,\n              p: \"measured\",\n            },\n            {\n              id: \"nashville_area\",\n              x: 220,\n              y: 138,\n              onset_rel: 1.2,\n              r_max: 17,\n              expand_s: 3.15,\n              p: \"measured\",\n            },\n            {\n              id: \"atlanta\",\n              x: 233,\n              y: 140,\n              onset_rel: 1.24,\n              r_max: 17,\n              expand_s: 3.15,\n              p: \"measured\",\n            },\n          ],\n          ring: {\n            rings_per_pulse: 2,\n            pulse_interval_s: 0.75,\n            expand_duration_s: 3.15,\n            r_max_px: 17,\n            stroke_px: 1.48,\n            intra_pulse_stagger_s: 0.28,\n            color: \"#FFFFFF\",\n            opacity: [0.5, 0.0],\n            ease: \"mildOut\",\n            opacity_ease: \"power1.in\",\n            max_pulses: 2,\n            p: \"measured\",\n            opacity_hold_frac: 0.65,\n            bloom: {\n              filter: \"filmBloom\",\n              std_wide: 0,\n              std_mid: 0,\n              std_tight: 0.62,\n              wide_weight: 0,\n              mid_weight: 0,\n              tight_weight: 1.0,\n              blend: \"normal\",\n              target_fwhm_px: 1.6,\n              note: \"pass8j-closer: stroke 1.48 + single soft-ink sigma0.62; op 0.50; NYC op_scale 1.70 (NE plate punch); KEEP normal; no multi-sigma/screen\",\n            },\n          },\n          fade: {\n            black_overlay_start: 1.0,\n            black_overlay_end: 0.0,\n            duration_s: 1.15,\n            ease: \"power2.in\",\n            color: \"#0F0F0F\",\n            p: \"measured\",\n            note: \"pass8i KEEP: stronger solid-to-fade hold power2.in over 1.15s; early SBS cols stay dark; ghost-dead t0\",\n          },\n          duration: 3.5,\n          ease_r_pow: 1.1,\n        };\n        function main() {\n          window.gsap = gsap;\n          const svg = document.getElementById(\"rings\");\n          const fade = document.getElementById(\"fade\");\n          const RINGS_PER = DATA.ring.rings_per_pulse;\n          const INTERVAL = DATA.ring.pulse_interval_s;\n          const EXPAND_DEFAULT = DATA.ring.expand_duration_s;\n          const RMAX_DEFAULT = DATA.ring.r_max_px;\n          const STAGGER = DATA.ring.intra_pulse_stagger_s || 0.3;\n          const OP0 = DATA.ring.opacity[0];\n          const HOLD = DATA.ring.opacity_hold_frac || 0.55;\n          const MAX_PULSES = DATA.ring.max_pulses || 2;\n          const DUR = DATA.duration;\n          const FADE = DATA.fade;\n          const mildOut = (t) =>\n            1 - Math.pow(1 - t, DATA.ease_r_pow != null ? DATA.ease_r_pow : 1.55);\n          const EASE_R = mildOut;\n          const EASE_OP = DATA.ring.opacity_ease || \"power1.in\";\n          const STROKE = DATA.ring.stroke_px;\n\n          const hubPulsePlan = [];\n          for (const h of DATA.hubs) {\n            const rMax = h.r_max != null ? h.r_max : RMAX_DEFAULT;\n            const expand = h.expand_s != null ? h.expand_s : EXPAND_DEFAULT;\n            const opPeak = OP0 * (h.op_scale != null ? h.op_scale : 1);\n            const pulses = [];\n            for (let p = 0; p < MAX_PULSES; p++) {\n              const start = h.onset_rel + p * INTERVAL;\n              if (start >= DUR - 0.2) break;\n              const group = [];\n              for (let k = 0; k < RINGS_PER; k++) {\n                const c = document.createElementNS(\"http://www.w3.org/2000/svg\", \"circle\");\n                c.setAttribute(\"class\", \"ring\");\n                c.setAttribute(\"cx\", h.x);\n                c.setAttribute(\"cy\", h.y);\n                c.setAttribute(\"r\", 0);\n                c.setAttribute(\"stroke-width\", STROKE);\n                svg.appendChild(c);\n                group.push(c);\n              }\n              pulses.push({ start, els: group, rMax, expand, opPeak });\n            }\n            hubPulsePlan.push({ hub: h, pulses });\n          }\n\n          const tl = gsap.timeline({ paused: true });\n          tl.set(fade, { opacity: FADE.black_overlay_start }, 0);\n          // stronger solid hold (power2.in) so early SBS cols stay dark/uniform\n          tl.to(\n            fade,\n            {\n              opacity: FADE.black_overlay_end,\n              duration: FADE.duration_s,\n              ease: FADE.ease || \"power2.in\",\n            },\n            0,\n          );\n\n          for (const { pulses } of hubPulsePlan) {\n            for (const pulse of pulses) {\n              pulse.els.forEach((el, k) => {\n                const delay = pulse.start + k * STAGGER;\n                if (delay >= DUR) return;\n                const holdT = pulse.expand * HOLD;\n                const fadeT = pulse.expand * (1 - HOLD);\n                const riseT = Math.min(0.14, holdT * 0.2);\n                const opPeak = pulse.opPeak;\n\n                tl.set(el, { attr: { r: 0 }, opacity: 0 }, delay);\n                tl.to(el, { attr: { r: pulse.rMax }, duration: pulse.expand, ease: EASE_R }, delay);\n                tl.to(el, { opacity: opPeak, duration: riseT, ease: \"sine.out\" }, delay);\n                tl.to(el, { opacity: 0, duration: fadeT, ease: EASE_OP }, delay + holdT);\n              });\n            }\n          }\n\n          window.__radarTimeline = tl;\n          window.__timelines = window.__timelines || {};\n          window.__timelines[\"map-radar-rings\"] = tl;\n          window.__duration = DUR;\n          window.__ready = true;\n          window.__bloom = DATA.ring.bloom;\n          window.__hubs = DATA.hubs.map((h) => h.id);\n          console.log(\n            \"ready hubs\",\n            DATA.hubs.map((h) => h.id),\n            \"dur\",\n            DUR,\n            \"r_max\",\n            RMAX_DEFAULT,\n            \"hold\",\n            HOLD,\n            \"bloom\",\n            DATA.ring.bloom,\n            \"op\",\n            OP0,\n            \"fade0\",\n            FADE.black_overlay_start,\n            \"stroke\",\n            STROKE,\n            \"fadeEase\",\n            FADE.ease,\n            \"easePow\",\n            DATA.ease_r_pow,\n          );\n        }\n        main();\n      </script>\n    </div>\n  </body>\n</html>\n"}