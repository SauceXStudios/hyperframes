{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-region-zoom {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mrz-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n        overflow: hidden;\n      }\n      #mrz-camera {\n        position: absolute;\n        left: 0;\n        top: 0;\n        width: 100%;\n        height: 100%;\n        transform-origin: 920px 560px;\n      }\n      #mrz-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mrz-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        z-index: 2;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n      }\n      #mrz-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        z-index: 2;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mrz-callout {\n        position: absolute;\n        bottom: 96px;\n        right: 120px;\n        z-index: 2;\n        padding: 14px 28px;\n        border: 1px solid rgba(196, 181, 154, 0.28);\n        color: rgba(232, 220, 196, 0.9);\n        font-size: 20px;\n        letter-spacing: 0.14em;\n        text-transform: uppercase;\n        background: rgba(26, 23, 20, 0.65);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-region-zoom\"\n      data-composition-id=\"map-region-zoom\"\n      data-start=\"0\"\n      data-duration=\"9\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mrz-frame\">\n        <div id=\"mrz-camera\">\n          <svg\n            id=\"mrz-svg\"\n            viewBox=\"0 0 1920 1080\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n            aria-hidden=\"true\"\n          >\n            <defs>\n              <pattern id=\"mrz-grid\" width=\"80\" height=\"80\" patternUnits=\"userSpaceOnUse\">\n                <path\n                  d=\"M 80 0 L 0 0 0 80\"\n                  fill=\"none\"\n                  stroke=\"rgba(196,181,154,0.12)\"\n                  stroke-width=\"1\"\n                />\n              </pattern>\n            </defs>\n            <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n            <rect\n              id=\"mrz-grid-layer\"\n              width=\"1920\"\n              height=\"1080\"\n              fill=\"url(#mrz-grid)\"\n              opacity=\"0\"\n            />\n            <path\n              id=\"mrz-land\"\n              d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n              fill=\"rgba(196,181,154,0.16)\"\n              stroke=\"rgba(196,181,154,0.4)\"\n              stroke-width=\"2\"\n            />\n            <path\n              id=\"mrz-island\"\n              d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n              fill=\"rgba(196,181,154,0.12)\"\n              stroke=\"rgba(196,181,154,0.3)\"\n              stroke-width=\"1.5\"\n            />\n            <path\n              id=\"mrz-detail\"\n              d=\"M 820 460 C 900 430 980 450 1020 510 C 1060 570 1020 630 940 650 C 860 670 780 620 780 550 C 780 500 790 475 820 460 Z\"\n              fill=\"rgba(196,181,154,0.08)\"\n              stroke=\"rgba(196,181,154,0.25)\"\n              stroke-width=\"1\"\n            />\n            <!-- focus rect -->\n            <rect\n              id=\"mrz-focus\"\n              x=\"760\"\n              y=\"420\"\n              width=\"320\"\n              height=\"260\"\n              fill=\"none\"\n              stroke=\"#c45c26\"\n              stroke-width=\"3\"\n              opacity=\"0\"\n            />\n            <rect\n              id=\"mrz-focus-fill\"\n              x=\"760\"\n              y=\"420\"\n              width=\"320\"\n              height=\"260\"\n              fill=\"#c45c26\"\n              fill-opacity=\"0.08\"\n              opacity=\"0\"\n            />\n            <circle id=\"mrz-focus-dot\" cx=\"920\" cy=\"560\" r=\"8\" fill=\"#c45c26\" opacity=\"0\" />\n          </svg>\n        </div>\n      </div>\n      <div id=\"mrz-title\" data-var-text=\"title\">Sector Focus</div>\n      <div id=\"mrz-subtitle\" data-var-text=\"subtitle\">Grid overlay · camera zoom</div>\n      <div id=\"mrz-callout\" data-var-text=\"regionLabel\">Sector 7</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Sector Focus\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Grid overlay · camera zoom\";\n        var regionLabel =\n          typeof vars.regionLabel === \"string\" && vars.regionLabel ? vars.regionLabel : \"Sector 7\";\n\n        document.getElementById(\"mrz-title\").textContent = title;\n        document.getElementById(\"mrz-subtitle\").textContent = subtitle;\n        document.getElementById(\"mrz-callout\").textContent = regionLabel;\n\n        document.getElementById(\"mrz-focus\").setAttribute(\"stroke\", accent);\n        document.getElementById(\"mrz-focus-fill\").setAttribute(\"fill\", accent);\n        document.getElementById(\"mrz-focus-dot\").setAttribute(\"fill\", accent);\n\n        gsap.set(\"#mrz-title\", { opacity: 0, y: -10 });\n        gsap.set(\"#mrz-subtitle\", { opacity: 0 });\n        gsap.set(\"#mrz-callout\", { opacity: 0 });\n        gsap.set(\"#mrz-land\", { opacity: 0 });\n        gsap.set(\"#mrz-island\", { opacity: 0 });\n        gsap.set(\"#mrz-detail\", { opacity: 0 });\n        gsap.set(\"#mrz-grid-layer\", { opacity: 0 });\n        gsap.set([\"#mrz-focus\", \"#mrz-focus-fill\", \"#mrz-focus-dot\"], { opacity: 0 });\n        gsap.set(\"#mrz-camera\", { scale: 1, x: 0, y: 0 });\n\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mrz-land\", { opacity: 1, duration: 0.5, ease: \"power2.out\" }, 0);\n        tl.to(\"#mrz-island\", { opacity: 1, duration: 0.4, ease: \"power2.out\" }, 0.12);\n        tl.to(\"#mrz-title\", { opacity: 1, y: 0, duration: 0.45, ease: \"power2.out\" }, 0.08);\n        tl.to(\"#mrz-subtitle\", { opacity: 1, duration: 0.35, ease: \"power1.out\" }, 0.28);\n        // Grid fades in  -  classic newsreel planning overlay\n        tl.to(\"#mrz-grid-layer\", { opacity: 1, duration: 0.7, ease: \"power1.out\" }, 0.9);\n        tl.to(\"#mrz-focus\", { opacity: 1, duration: 0.35, ease: \"power2.out\" }, 1.5);\n        tl.to(\"#mrz-focus-fill\", { opacity: 1, duration: 0.35, ease: \"power2.out\" }, 1.5);\n        tl.to(\"#mrz-focus-dot\", { opacity: 1, duration: 0.3, ease: \"power2.out\" }, 1.7);\n        tl.to(\"#mrz-detail\", { opacity: 1, duration: 0.4, ease: \"power1.out\" }, 1.8);\n        // Camera zoom into focus region\n        tl.to(\"#mrz-camera\", { scale: 2.15, duration: 2.8, ease: \"power2.inOut\" }, 2.4);\n        tl.to(\"#mrz-callout\", { opacity: 1, duration: 0.45, ease: \"power2.out\" }, 4.8);\n        // Settle\n        tl.to(\"#mrz-focus\", { strokeWidth: 4, duration: 0.5, ease: \"sine.inOut\" }, 5.4);\n\n        window.__timelines[\"map-region-zoom\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}