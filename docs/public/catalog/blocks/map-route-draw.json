{"html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-route-draw {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: \"Georgia\", \"Times New Roman\", serif;\n      }\n      #mrd-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mrd-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mrd-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mrd-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mrd-legend {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.7);\n        font-size: 18px;\n        letter-spacing: 0.12em;\n        text-transform: uppercase;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-route-draw\"\n      data-composition-id=\"map-route-draw\"\n      data-start=\"0\"\n      data-duration=\"8\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mrd-frame\">\n        <svg\n          id=\"mrd-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mrd-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n          <!-- ocean plate -->\n          <rect x=\"0\" y=\"0\" width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect x=\"0\" y=\"0\" width=\"1920\" height=\"1080\" fill=\"url(#mrd-hatch)\" />\n          <!-- stylized landmass -->\n          <path\n            id=\"mrd-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.18)\"\n            stroke=\"rgba(196,181,154,0.45)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mrd-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.14)\"\n            stroke=\"rgba(196,181,154,0.35)\"\n            stroke-width=\"1.5\"\n          />\n          <!-- latitude lines -->\n          <g id=\"mrd-lat\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" fill=\"none\">\n            <path d=\"M 200 360 H 1700\" />\n            <path d=\"M 200 520 H 1700\" />\n            <path d=\"M 200 680 H 1700\" />\n          </g>\n          <!-- route -->\n          <path\n            id=\"mrd-route\"\n            d=\"M 420 520 C 560 460 720 400 860 420 C 1000 440 1120 520 1240 500 C 1320 488 1400 460 1520 470\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"4\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n          />\n          <circle id=\"mrd-start\" cx=\"420\" cy=\"520\" r=\"10\" fill=\"#c45c26\" />\n          <circle id=\"mrd-end\" cx=\"1520\" cy=\"470\" r=\"10\" fill=\"#c45c26\" opacity=\"0\" />\n          <circle\n            id=\"mrd-end-ring\"\n            cx=\"1520\"\n            cy=\"470\"\n            r=\"22\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2\"\n            opacity=\"0\"\n          />\n          <text\n            id=\"mrd-from\"\n            x=\"420\"\n            y=\"560\"\n            text-anchor=\"middle\"\n            fill=\"rgba(232,220,196,0.85)\"\n            font-size=\"20\"\n            font-family=\"Georgia, serif\"\n          >\n            ORIGIN\n          </text>\n          <text\n            id=\"mrd-to\"\n            x=\"1520\"\n            y=\"510\"\n            text-anchor=\"middle\"\n            fill=\"rgba(232,220,196,0.85)\"\n            font-size=\"20\"\n            font-family=\"Georgia, serif\"\n            opacity=\"0\"\n          >\n            DESTINATION\n          </text>\n        </svg>\n      </div>\n      <div id=\"mrd-title\" data-var-text=\"title\">The Overland Route</div>\n      <div id=\"mrd-subtitle\" data-var-text=\"subtitle\">Educational cartography · route draw-on</div>\n      <div id=\"mrd-legend\">Stroke reveals the path · not a live basemap</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title =\n          typeof vars.title === \"string\" && vars.title ? vars.title : \"The Overland Route\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography · route draw-on\";\n        var fromLabel =\n          typeof vars.fromLabel === \"string\" && vars.fromLabel ? vars.fromLabel : \"ORIGIN\";\n        var toLabel =\n          typeof vars.toLabel === \"string\" && vars.toLabel ? vars.toLabel : \"DESTINATION\";\n\n        document.getElementById(\"mrd-title\").textContent = title;\n        document.getElementById(\"mrd-subtitle\").textContent = subtitle;\n        document.getElementById(\"mrd-from\").textContent = fromLabel;\n        document.getElementById(\"mrd-to\").textContent = toLabel;\n\n        var route = document.getElementById(\"mrd-route\");\n        var start = document.getElementById(\"mrd-start\");\n        var end = document.getElementById(\"mrd-end\");\n        var endRing = document.getElementById(\"mrd-end-ring\");\n        route.setAttribute(\"stroke\", accent);\n        start.setAttribute(\"fill\", accent);\n        end.setAttribute(\"fill\", accent);\n        endRing.setAttribute(\"stroke\", accent);\n\n        var len = route.getTotalLength();\n        gsap.set(route, { strokeDasharray: len, strokeDashoffset: len });\n        gsap.set([end, endRing, \"#mrd-to\"], { opacity: 0 });\n        gsap.set(\"#mrd-title\", { opacity: 0, y: -12 });\n        gsap.set(\"#mrd-subtitle\", { opacity: 0 });\n        gsap.set(\"#mrd-land\", { opacity: 0 });\n        gsap.set(\"#mrd-island\", { opacity: 0 });\n        gsap.set(\"#mrd-from\", { opacity: 0 });\n        gsap.set(start, { scale: 0, transformOrigin: \"50% 50%\" });\n\n        var tl = gsap.timeline({ paused: true });\n        // Hero: landmass + title in first second\n        tl.to(\"#mrd-land\", { opacity: 1, duration: 0.55, ease: \"power2.out\" }, 0);\n        tl.to(\"#mrd-island\", { opacity: 1, duration: 0.45, ease: \"power2.out\" }, 0.15);\n        tl.to(\"#mrd-title\", { opacity: 1, y: 0, duration: 0.5, ease: \"power2.out\" }, 0.1);\n        tl.to(\"#mrd-subtitle\", { opacity: 1, duration: 0.4, ease: \"power1.out\" }, 0.35);\n        tl.to(start, { scale: 1, duration: 0.35, ease: \"back.out(1.8)\" }, 0.55);\n        tl.to(\"#mrd-from\", { opacity: 1, duration: 0.3, ease: \"power1.out\" }, 0.7);\n        // Route draw-on\n        tl.to(route, { strokeDashoffset: 0, duration: 3.2, ease: \"power1.inOut\" }, 1.0);\n        tl.to(end, { opacity: 1, duration: 0.25, ease: \"power2.out\" }, 4.0);\n        tl.fromTo(\n          endRing,\n          { opacity: 0, scale: 0.4 },\n          { opacity: 1, scale: 1, duration: 0.45, ease: \"power2.out\", transformOrigin: \"50% 50%\" },\n          4.05,\n        );\n        tl.to(\"#mrd-to\", { opacity: 1, duration: 0.35, ease: \"power1.out\" }, 4.2);\n        // Soft hold settle\n        tl.to(\"#mrd-legend\", { opacity: 0.7, duration: 0.4, ease: \"power1.out\" }, 5.0);\n        gsap.set(\"#mrd-legend\", { opacity: 0 });\n\n        window.__timelines[\"map-route-draw\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}
