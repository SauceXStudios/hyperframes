{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-shipping-lanes {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #msl-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #msl-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #msl-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #msl-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #msl-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-shipping-lanes\"\n      data-composition-id=\"map-shipping-lanes\"\n      data-start=\"0\"\n      data-duration=\"9\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"msl-frame\">\n        <svg\n          id=\"msl-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"msl-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#msl-hatch)\" />\n          <path\n            id=\"msl-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"msl-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n\n          <path\n            id=\"msl-lane1\"\n            d=\"M 400 640 C 560 700 780 720 980 680 C 1180 640 1380 600 1520 520\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"3\"\n            stroke-linecap=\"round\"\n          />\n          <path\n            id=\"msl-lane2\"\n            d=\"M 440 580 C 640 540 860 500 1080 520 C 1280 540 1420 480 1560 440\"\n            fill=\"none\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2.5\"\n            stroke-linecap=\"round\"\n            opacity=\"0.7\"\n          />\n          <circle id=\"msl-pa\" cx=\"400\" cy=\"640\" r=\"10\" fill=\"#c45c26\" />\n          <circle id=\"msl-pb\" cx=\"1520\" cy=\"520\" r=\"10\" fill=\"#c45c26\" />\n          <text\n            id=\"msl-from\"\n            x=\"400\"\n            y=\"680\"\n            text-anchor=\"middle\"\n            fill=\"rgba(232,220,196,0.85)\"\n            font-size=\"18\"\n            font-family=\"Georgia, serif\"\n          >\n            PORT A\n          </text>\n          <text\n            id=\"msl-to\"\n            x=\"1520\"\n            y=\"560\"\n            text-anchor=\"middle\"\n            fill=\"rgba(232,220,196,0.85)\"\n            font-size=\"18\"\n            font-family=\"Georgia, serif\"\n          >\n            PORT B\n          </text>\n        </svg>\n      </div>\n      <div id=\"msl-title\" data-var-text=\"title\">Sea Lanes</div>\n      <div id=\"msl-subtitle\" data-var-text=\"subtitle\">Educational cartography · shipping lanes</div>\n      <div id=\"msl-note\">Dotted sea lanes · schematic ports only</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Sea Lanes\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 shipping lanes\";\n        var fromLabel =\n          typeof vars.fromLabel === \"string\" && vars.fromLabel ? vars.fromLabel : \"PORT A\";\n        var toLabel = typeof vars.toLabel === \"string\" && vars.toLabel ? vars.toLabel : \"PORT B\";\n\n        document.getElementById(\"msl-title\").textContent = title;\n        document.getElementById(\"msl-subtitle\").textContent = subtitle;\n        document.getElementById(\"msl-from\").textContent = fromLabel;\n        document.getElementById(\"msl-to\").textContent = toLabel;\n        [\"msl-lane1\", \"msl-lane2\"].forEach(function (id) {\n          document.getElementById(id).setAttribute(\"stroke\", accent);\n        });\n        document.getElementById(\"msl-pa\").setAttribute(\"fill\", accent);\n        document.getElementById(\"msl-pb\").setAttribute(\"fill\", accent);\n        var l1 = document.getElementById(\"msl-lane1\");\n        var l2 = document.getElementById(\"msl-lane2\");\n        var len1 = l1.getTotalLength(),\n          len2 = l2.getTotalLength();\n        gsap.set(l1, { strokeDasharray: \"3 14\", strokeDashoffset: len1 });\n        gsap.set(l2, { strokeDasharray: \"3 14\", strokeDashoffset: len2 });\n        gsap.set(\n          [\n            \"#msl-land\",\n            \"#msl-island\",\n            \"#msl-from\",\n            \"#msl-to\",\n            \"#msl-pa\",\n            \"#msl-pb\",\n            \"#msl-title\",\n            \"#msl-subtitle\",\n            \"#msl-note\",\n          ],\n          { opacity: 0 },\n        );\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#msl-land\", { opacity: 1, duration: 0.5 }, 0);\n        tl.to(\"#msl-island\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#msl-title\", { opacity: 1, duration: 0.4 }, 0.15);\n        tl.to(\"#msl-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        tl.to([\"#msl-pa\", \"#msl-from\"], { opacity: 1, duration: 0.35 }, 0.7);\n        tl.to(l1, { strokeDashoffset: 0, duration: 3.5, ease: \"power1.inOut\" }, 1.1);\n        tl.to(l2, { strokeDashoffset: 0, duration: 3.2, ease: \"power1.inOut\" }, 1.6);\n        tl.to([\"#msl-pb\", \"#msl-to\"], { opacity: 1, duration: 0.35 }, 4.4);\n        tl.to(\"#msl-note\", { opacity: 1, duration: 0.4 }, 5.5);\n        window.__timelines[\"map-shipping-lanes\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}