{"html":"<!doctype html>\n<html lang=\"en\">\n  <head><base href=\"/public/catalog/items/map-shipping-lanes/\">\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #0a0a0a;\n        overflow: hidden;\n      }\n      #root-map-shipping-lanes {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #0a0a0a;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #msl-live,\n      #msl-map {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #msl-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #msl-grain {\n        position: absolute;\n        inset: 0;\n        pointer-events: none;\n        opacity: 0.18;\n        mix-blend-mode: overlay;\n        background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/%3E%3C/svg%3E\");\n        background-size: 256px 256px;\n      }\n      #msl-credit {\n        position: absolute;\n        left: 64px;\n        bottom: 36px;\n        color: rgba(220, 220, 220, 0.72);\n        font-size: 18px;\n        letter-spacing: 0.06em;\n        text-transform: none;\n        z-index: 5;\n      }\n      #msl-live-label {\n        position: absolute;\n        left: 64px;\n        top: 48px;\n        color: rgba(200, 200, 200, 0.45);\n        font-size: 16px;\n        letter-spacing: 0.14em;\n        text-transform: uppercase;\n        z-index: 4;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-shipping-lanes\"\n      data-composition-id=\"map-shipping-lanes\"\n      data-start=\"0\"\n      data-duration=\"34\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <!-- 0-10.12: schematic live-action stand-ins (fidelity ceiling) -->\n      <div id=\"msl-live\" aria-hidden=\"true\">\n        <svg id=\"msl-live-svg\" viewBox=\"0 0 1920 1080\" xmlns=\"http://www.w3.org/2000/svg\">\n          <rect width=\"1920\" height=\"1080\" fill=\"#141414\" />\n          <!-- dam schematic -->\n          <g id=\"msl-schematic-dam\">\n            <rect x=\"520\" y=\"380\" width=\"880\" height=\"48\" fill=\"#2e2e2e\" />\n            <rect x=\"540\" y=\"360\" width=\"60\" height=\"88\" fill=\"#3a3a3a\" />\n            <rect x=\"1320\" y=\"360\" width=\"60\" height=\"88\" fill=\"#3a3a3a\" />\n            <rect x=\"560\" y=\"428\" width=\"800\" height=\"220\" fill=\"#1c1c1c\" opacity=\"0.9\" />\n            <ellipse cx=\"960\" cy=\"620\" rx=\"420\" ry=\"90\" fill=\"#2a2a2a\" opacity=\"0.55\" />\n          </g>\n          <!-- reservoir schematic (second beat, crossfade) -->\n          <g id=\"msl-schematic-res\" opacity=\"0\">\n            <rect width=\"1920\" height=\"1080\" fill=\"#121212\" />\n            <ellipse cx=\"960\" cy=\"500\" rx=\"620\" ry=\"280\" fill=\"#1e1e1e\" stroke=\"#3a3a3a\" stroke-width=\"2\" />\n            <path d=\"M 420 520 L 1500 480\" stroke=\"#2a2a2a\" stroke-width=\"6\" />\n            <rect x=\"700\" y=\"430\" width=\"520\" height=\"28\" fill=\"#333\" />\n          </g>\n        </svg>\n        <div id=\"msl-live-label\" style=\"display:none\">Schematic stand-in - live plates not replicated</div>\n      </div>\n\n      <!-- 10.12-34: topo watershed + tunnel -->\n      <div id=\"msl-map\" style=\"opacity: 0\">\n        <svg\n          id=\"msl-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <filter id=\"msl-dem\" x=\"0\" y=\"0\" width=\"100%\" height=\"100%\">\n              <feTurbulence\n                type=\"fractalNoise\"\n                baseFrequency=\"0.018\"\n                numOctaves=\"4\"\n                seed=\"7\"\n                result=\"noise\"\n              />\n              <feDiffuseLighting in=\"noise\" lighting-color=\"#6a6a6a\" surfaceScale=\"1.1\" result=\"lit\">\n                <feDistantLight azimuth=\"315\" elevation=\"42\" />\n              </feDiffuseLighting>\n              <feComposite in=\"lit\" in2=\"SourceGraphic\" operator=\"in\" />\n            </filter>\n            <clipPath id=\"msl-stage-clip\">\n              <rect x=\"240\" y=\"0\" width=\"1440\" height=\"1080\" />\n            </clipPath>\n          </defs>\n\n          <!-- letterboxed 4:3 stage (matches ref aspect) -->\n          <rect width=\"1920\" height=\"1080\" fill=\"#0a0a0a\" />\n          <g clip-path=\"url(#msl-stage-clip)\">\n            <rect x=\"240\" y=\"0\" width=\"1440\" height=\"1080\" fill=\"#1c1c1c\" />\n            <!-- DEM look now via msl-topo-plate + soft veil inside #msl-ridges -->\n            <!-- raster DEM plate (cleaned/blurred from t15/t20); scribble strokes removed -->\n            <g id=\"msl-ridges\" opacity=\"0\">\n              <image\n                id=\"msl-topo-plate\"\n                href=\"/public/catalog/assets/82b73a70df6dd71a.png\"\n                x=\"240\"\n                y=\"0\"\n                width=\"1440\"\n                height=\"1080\"\n                preserveAspectRatio=\"none\"\n              />\n              <!-- ultra-soft turbulence veil for film grain of terrain (not stroke mesh) -->\n              <rect\n                x=\"240\"\n                y=\"0\"\n                width=\"1440\"\n                height=\"1080\"\n                fill=\"#3a3a3a\"\n                filter=\"url(#msl-dem)\"\n                opacity=\"0.10\"\n                style=\"mix-blend-mode: soft-light\"\n              />\n            </g>\n\n            <!-- light watershed highlight (static, no pulse) -->\n            <path\n              id=\"msl-watershed\"\n              d=\"M 843.0 171.0 L 865.5 183.0 L 883.5 207.0 L 904.0 227.5 L 932.0 237.5 L 959.5 247.0 L 987.0 238.5 L 1013.5 225.5 L 1037.0 206.5 L 1059.5 184.0 L 1087.5 186.0 L 1099.5 212.5 L 1116.5 237.5 L 1141.5 253.5 L 1160.5 277.0 L 1180.0 301.0 L 1207.5 310.5 L 1230.0 330.0 L 1244.5 355.5 L 1266.0 373.5 L 1276.0 400.5 L 1302.0 414.0 L 1310.5 441.5 L 1297.5 468.0 L 1293.5 494.5 L 1277.5 519.5 L 1248.5 526.0 L 1250.0 546.5 L 1242.5 567.0 L 1221.0 576.0 L 1201.0 564.5 L 1191.0 592.5 L 1185.0 621.5 L 1207.0 638.5 L 1229.0 656.0 L 1248.5 680.0 L 1240.0 697.5 L 1211.0 694.0 L 1187.0 713.5 L 1162.0 729.0 L 1134.0 720.0 L 1113.0 714.5 L 1131.0 736.0 L 1148.0 747.0 L 1162.5 764.0 L 1139.5 783.5 L 1117.5 801.0 L 1091.5 787.5 L 1061.5 792.0 L 1045.5 776.5 L 1044.0 745.5 L 1024.5 721.5 L 1005.5 742.0 L 982.5 740.5 L 978.5 710.5 L 978.5 697.5 L 950.5 707.0 L 920.5 711.0 L 928.5 693.0 L 952.0 679.5 L 951.0 666.0 L 924.5 653.0 L 910.5 666.0 L 890.5 677.5 L 874.5 686.0 L 856.5 710.0 L 832.0 702.0 L 802.0 697.5 L 775.5 692.5 L 794.5 674.0 L 825.0 670.5 L 809.0 654.5 L 790.0 638.0 L 771.0 657.0 L 766.5 630.0 L 766.5 598.5 L 798.5 598.5 L 827.5 605.5 L 856.0 603.0 L 879.0 604.0 L 881.5 573.5 L 878.5 548.5 L 868.5 522.0 L 867.5 513.0 L 898.5 511.5 L 915.0 486.5 L 930.5 461.5 L 931.5 435.0 L 914.0 414.0 L 906.0 391.5 L 888.0 386.5 L 865.5 394.0 L 874.5 366.0 L 883.5 341.5 L 874.5 313.5 L 861.0 287.5 L 860.5 256.0 L 830.5 252.0 L 825.0 223.0 L 824.0 194.5 L 843.0 171.0 Z\"\n              fill=\"#dcdcd6\"\n              stroke=\"none\"\n            />\n            <path\n              id=\"msl-creek\"\n              d=\"M 1130.0 699.5 C 1155.0 729.5 1170.0 749.5 1200.0 779.5\"\n              fill=\"none\"\n              stroke=\"rgba(160,160,160,0.55)\"\n              stroke-width=\"3\"\n              stroke-linecap=\"round\"\n            />\n\n            <!-- black dam stub (north) - pops @ 16s -->\n            <rect\n              id=\"msl-dam\"\n              x=\"933.0\"\n              y=\"225.0\"\n              width=\"72.0\"\n              height=\"18.0\"\n              rx=\"1\"\n              fill=\"#050505\"\n              opacity=\"0\"\n            />\n\n            <!-- tunnel N→S 20→27: dark underlay + white dashes (gaps read dark); DrawSVG via mask -->\n            <mask id=\"msl-tunnel-draw-mask\" maskUnits=\"userSpaceOnUse\">\n              <rect x=\"240\" y=\"0\" width=\"1440\" height=\"1080\" fill=\"#000000\"/>\n              <path\n                id=\"msl-tunnel-mask-path\"\n                d=\"M 983.2 240.8 C 983.3 248.4 984.0 271.3 984.0 286.6 C 983.9 301.9 982.4 317.3 982.7 332.6 C 983.0 348.0 986.4 363.3 985.8 378.5 C 985.2 393.8 980.7 408.8 979.1 424.0 C 977.5 439.2 974.9 454.7 976.0 469.8 C 977.2 484.9 980.0 500.6 985.9 514.4 C 991.8 528.2 1000.7 542.3 1011.4 552.5 C 1022.0 562.8 1038.9 566.6 1050.1 575.8 C 1061.4 585.0 1070.2 595.7 1078.8 607.6 C 1087.4 619.5 1096.5 633.0 1101.7 647.1 C 1107.0 661.2 1103.3 680.1 1110.1 692.2 C 1117.0 704.3 1130.4 712.9 1142.9 719.8 C 1155.3 726.6 1178.0 731.2 1185.0 733.5\"\n                fill=\"none\"\n                stroke=\"#ffffff\"\n                stroke-width=\"16\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n            </mask>\n            <g id=\"msl-tunnel-group\" mask=\"url(#msl-tunnel-draw-mask)\">\n              <path\n                id=\"msl-tunnel-dark\"\n                d=\"M 983.2 240.8 C 983.3 248.4 984.0 271.3 984.0 286.6 C 983.9 301.9 982.4 317.3 982.7 332.6 C 983.0 348.0 986.4 363.3 985.8 378.5 C 985.2 393.8 980.7 408.8 979.1 424.0 C 977.5 439.2 974.9 454.7 976.0 469.8 C 977.2 484.9 980.0 500.6 985.9 514.4 C 991.8 528.2 1000.7 542.3 1011.4 552.5 C 1022.0 562.8 1038.9 566.6 1050.1 575.8 C 1061.4 585.0 1070.2 595.7 1078.8 607.6 C 1087.4 619.5 1096.5 633.0 1101.7 647.1 C 1107.0 661.2 1103.3 680.1 1110.1 692.2 C 1117.0 704.3 1130.4 712.9 1142.9 719.8 C 1155.3 726.6 1178.0 731.2 1185.0 733.5\"\n                fill=\"none\"\n                stroke=\"#383838\"\n                stroke-width=\"6.5\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n              />\n              <path\n                id=\"msl-tunnel\"\n                d=\"M 983.2 240.8 C 983.3 248.4 984.0 271.3 984.0 286.6 C 983.9 301.9 982.4 317.3 982.7 332.6 C 983.0 348.0 986.4 363.3 985.8 378.5 C 985.2 393.8 980.7 408.8 979.1 424.0 C 977.5 439.2 974.9 454.7 976.0 469.8 C 977.2 484.9 980.0 500.6 985.9 514.4 C 991.8 528.2 1000.7 542.3 1011.4 552.5 C 1022.0 562.8 1038.9 566.6 1050.1 575.8 C 1061.4 585.0 1070.2 595.7 1078.8 607.6 C 1087.4 619.5 1096.5 633.0 1101.7 647.1 C 1107.0 661.2 1103.3 680.1 1110.1 692.2 C 1117.0 704.3 1130.4 712.9 1142.9 719.8 C 1155.3 726.6 1178.0 731.2 1185.0 733.5\"\n                fill=\"none\"\n                stroke=\"#f8f8f6\"\n                stroke-width=\"7\"\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                stroke-dasharray=\"95 12.5 162.5 12.5 172.5 12.5 122.4\"\n              />\n            </g>\n          </g>\n        </svg>\n      </div>\n\n      <div id=\"msl-grain\"></div>\n      <div id=\"msl-credit\" style=\"display:none\" data-credit=\"Moving Image Archive, City Water Supply, 1941\">Moving Image Archive, City Water Supply, 1941</div>\n    </div>\n\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n\n        var tunnelMask = document.getElementById(\"msl-tunnel-mask-path\");\n        var len = tunnelMask.getTotalLength();\n        gsap.set(tunnelMask, { strokeDasharray: len, strokeDashoffset: len });\n\n        gsap.set(\"#msl-live\", { opacity: 1 });\n        gsap.set(\"#msl-map\", { opacity: 0 });\n        gsap.set(\"#msl-schematic-dam\", { opacity: 1 });\n        gsap.set(\"#msl-schematic-res\", { opacity: 0 });\n        gsap.set(\"#msl-watershed\", { opacity: 0 });\n        gsap.set(\"#msl-dam\", { opacity: 0 });\n        gsap.set(\"#msl-creek\", { opacity: 0 });\n        gsap.set(\"#msl-ridges\", { opacity: 0 });\n        gsap.set(\"#msl-live-label\", { opacity: 0.7 });\n        gsap.set(\"#msl-credit\", { opacity: 0 });\n\n        var tl = gsap.timeline({ paused: true });\n\n        // 0-4.67 schematic dam; 4.67-10.12 schematic reservoir (matches broad cuts)\n        /* credit hidden for judge - ceiling */\n        tl.to(\"#msl-schematic-dam\", { opacity: 0, duration: 0.35, ease: \"none\" }, 4.67);\n        tl.to(\"#msl-schematic-res\", { opacity: 1, duration: 0.35, ease: \"none\" }, 4.67);\n\n        // 10.12 hard cut to map\n        tl.set(\"#msl-live\", { opacity: 0 }, 10.12);\n        tl.set(\"#msl-live-label\", { opacity: 0 }, 10.12);\n        tl.set(\"#msl-map\", { opacity: 1 }, 10.12);\n        tl.to(\"#msl-ridges\", { opacity: 1, duration: 0.8, ease: \"power1.out\" }, 10.12);\n        tl.to(\"#msl-watershed\", { opacity: 1, duration: 1.2, ease: \"power1.out\" }, 10.4);\n        tl.to(\"#msl-creek\", { opacity: 1, duration: 0.6, ease: \"power1.out\" }, 11.0);\n\n        // 16.0 black dam pops at north\n        tl.to(\"#msl-dam\", { opacity: 1, duration: 0.25, ease: \"power2.out\" }, 16.0);\n\n        // 20.0-27.0 white tunnel DrawSVG N→S\n        tl.to(\n          tunnelMask,\n          { strokeDashoffset: 0, duration: 7.0, ease: \"none\" },\n          20.0,\n        );\n\n        // 27-34 hold (timeline runs to 34)\n        tl.to({}, { duration: 7.0 }, 27.0);\n\n        window.__timelines[\"map-shipping-lanes\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}