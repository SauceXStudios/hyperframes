{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-split-theater {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #msx-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #msx-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #msx-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #msx-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #msx-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-split-theater\"\n      data-composition-id=\"map-split-theater\"\n      data-start=\"0\"\n      data-duration=\"8\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"msx-frame\">\n        <svg\n          id=\"msx-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"msx-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#msx-hatch)\" />\n          <clipPath id=\"msx-clip-l\"><rect x=\"0\" y=\"0\" width=\"960\" height=\"1080\" /></clipPath>\n          <clipPath id=\"msx-clip-r\"><rect x=\"960\" y=\"0\" width=\"960\" height=\"1080\" /></clipPath>\n          <g id=\"msx-left\" clip-path=\"url(#msx-clip-l)\">\n            <path\n              id=\"msx-land-l\"\n              d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n              fill=\"rgba(196,181,154,0.16)\"\n              stroke=\"rgba(196,181,154,0.4)\"\n              stroke-width=\"2\"\n              transform=\"translate(-200 0) scale(0.85)\"\n            />\n            <path\n              id=\"msx-a1\"\n              d=\"M 280 600 L 520 480\"\n              fill=\"none\"\n              stroke=\"#c45c26\"\n              stroke-width=\"4\"\n              stroke-linecap=\"round\"\n            />\n          </g>\n          <g id=\"msx-right\" clip-path=\"url(#msx-clip-r)\">\n            <path\n              id=\"msx-land-r\"\n              d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n              fill=\"rgba(196,181,154,0.16)\"\n              stroke=\"rgba(196,181,154,0.4)\"\n              stroke-width=\"2\"\n              transform=\"translate(420 40) scale(0.85)\"\n            />\n            <path\n              id=\"msx-a2\"\n              d=\"M 1280 520 L 1520 640\"\n              fill=\"none\"\n              stroke=\"#c45c26\"\n              stroke-width=\"4\"\n              stroke-linecap=\"round\"\n            />\n          </g>\n          <line\n            id=\"msx-divider\"\n            x1=\"960\"\n            y1=\"120\"\n            x2=\"960\"\n            y2=\"960\"\n            stroke=\"rgba(196,181,154,0.35)\"\n            stroke-width=\"2\"\n          />\n          <text\n            id=\"msx-lt\"\n            x=\"480\"\n            y=\"200\"\n            text-anchor=\"middle\"\n            fill=\"rgba(232,220,196,0.8)\"\n            font-size=\"28\"\n            font-family=\"Georgia, serif\"\n            letter-spacing=\"0.2em\"\n          >\n            WEST\n          </text>\n          <text\n            id=\"msx-rt\"\n            x=\"1440\"\n            y=\"200\"\n            text-anchor=\"middle\"\n            fill=\"rgba(232,220,196,0.8)\"\n            font-size=\"28\"\n            font-family=\"Georgia, serif\"\n            letter-spacing=\"0.2em\"\n          >\n            EAST\n          </text>\n        </svg>\n      </div>\n      <div id=\"msx-title\" data-var-text=\"title\">Two Theaters</div>\n      <div id=\"msx-subtitle\" data-var-text=\"subtitle\">Educational cartography · split screen</div>\n      <div id=\"msx-note\">Split-screen theaters · abstract dual campaigns</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Two Theaters\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 split screen\";\n        var leftTitle =\n          typeof vars.leftTitle === \"string\" && vars.leftTitle ? vars.leftTitle : \"WEST\";\n        var rightTitle =\n          typeof vars.rightTitle === \"string\" && vars.rightTitle ? vars.rightTitle : \"EAST\";\n\n        document.getElementById(\"msx-title\").textContent = title;\n        document.getElementById(\"msx-subtitle\").textContent = subtitle;\n        document.getElementById(\"msx-lt\").textContent = leftTitle;\n        document.getElementById(\"msx-rt\").textContent = rightTitle;\n        document.getElementById(\"msx-a1\").setAttribute(\"stroke\", accent);\n        document.getElementById(\"msx-a2\").setAttribute(\"stroke\", accent);\n        var a1 = document.getElementById(\"msx-a1\");\n        var a2 = document.getElementById(\"msx-a2\");\n        var len1 = a1.getTotalLength(),\n          len2 = a2.getTotalLength();\n        gsap.set(a1, { strokeDasharray: len1, strokeDashoffset: len1 });\n        gsap.set(a2, { strokeDasharray: len2, strokeDashoffset: len2 });\n        gsap.set(\n          [\n            \"#msx-left\",\n            \"#msx-right\",\n            \"#msx-divider\",\n            \"#msx-lt\",\n            \"#msx-rt\",\n            \"#msx-title\",\n            \"#msx-subtitle\",\n            \"#msx-note\",\n          ],\n          { opacity: 0 },\n        );\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#msx-title\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#msx-subtitle\", { opacity: 1, duration: 0.35 }, 0.3);\n        tl.to(\"#msx-divider\", { opacity: 1, duration: 0.4 }, 0.5);\n        tl.to(\"#msx-left\", { opacity: 1, duration: 0.5 }, 0.7);\n        tl.to(\"#msx-lt\", { opacity: 1, duration: 0.35 }, 0.9);\n        tl.to(\"#msx-right\", { opacity: 1, duration: 0.5 }, 1.2);\n        tl.to(\"#msx-rt\", { opacity: 1, duration: 0.35 }, 1.4);\n        tl.to(a1, { strokeDashoffset: 0, duration: 1.8, ease: \"power1.inOut\" }, 2.0);\n        tl.to(a2, { strokeDashoffset: 0, duration: 1.8, ease: \"power1.inOut\" }, 2.4);\n        tl.to(\"#msx-note\", { opacity: 1, duration: 0.4 }, 5.0);\n        window.__timelines[\"map-split-theater\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}