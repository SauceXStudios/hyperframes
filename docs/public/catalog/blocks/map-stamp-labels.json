{"html": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-stamp-labels {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mst-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mst-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mst-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        font-weight: 400;\n      }\n      #mst-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mst-note {\n        position: absolute;\n        bottom: 88px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 16px;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        max-width: 900px;\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-stamp-labels\"\n      data-composition-id=\"map-stamp-labels\"\n      data-start=\"0\"\n      data-duration=\"8\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mst-frame\">\n        <svg\n          id=\"mst-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <pattern\n              id=\"mst-hatch\"\n              width=\"12\"\n              height=\"12\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(35)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"12\" stroke=\"rgba(196,181,154,0.08)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mst-hatch)\" />\n          <path\n            id=\"mst-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mst-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n\n          <g id=\"mst-stamp1\">\n            <rect\n              x=\"450\"\n              y=\"452\"\n              width=\"140\"\n              height=\"56\"\n              fill=\"none\"\n              stroke=\"#c45c26\"\n              stroke-width=\"3\"\n              rx=\"2\"\n            />\n            <text\n              id=\"mst-t1\"\n              x=\"520\"\n              y=\"488\"\n              text-anchor=\"middle\"\n              fill=\"#c45c26\"\n              font-size=\"26\"\n              font-family=\"Georgia, serif\"\n              letter-spacing=\"0.18em\"\n            >\n              HAVEN\n            </text>\n          </g>\n          <g id=\"mst-stamp2\">\n            <rect\n              x=\"830\"\n              y=\"372\"\n              width=\"140\"\n              height=\"56\"\n              fill=\"none\"\n              stroke=\"#c45c26\"\n              stroke-width=\"3\"\n              rx=\"2\"\n            />\n            <text\n              id=\"mst-t2\"\n              x=\"900\"\n              y=\"408\"\n              text-anchor=\"middle\"\n              fill=\"#c45c26\"\n              font-size=\"26\"\n              font-family=\"Georgia, serif\"\n              letter-spacing=\"0.18em\"\n            >\n              RIDGE\n            </text>\n          </g>\n          <g id=\"mst-stamp3\">\n            <rect\n              x=\"1110\"\n              y=\"592\"\n              width=\"140\"\n              height=\"56\"\n              fill=\"none\"\n              stroke=\"#c45c26\"\n              stroke-width=\"3\"\n              rx=\"2\"\n            />\n            <text\n              id=\"mst-t3\"\n              x=\"1180\"\n              y=\"628\"\n              text-anchor=\"middle\"\n              fill=\"#c45c26\"\n              font-size=\"26\"\n              font-family=\"Georgia, serif\"\n              letter-spacing=\"0.18em\"\n            >\n              FORD\n            </text>\n          </g>\n        </svg>\n      </div>\n      <div id=\"mst-title\" data-var-text=\"title\">Stamped Places</div>\n      <div id=\"mst-subtitle\" data-var-text=\"subtitle\">Educational cartography · stamp labels</div>\n      <div id=\"mst-note\">Stamp slam · typewriter place marks</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title = typeof vars.title === \"string\" && vars.title ? vars.title : \"Stamped Places\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Educational cartography \\u00b7 stamp labels\";\n        var labelA = typeof vars.labelA === \"string\" && vars.labelA ? vars.labelA : \"HAVEN\";\n        var labelB = typeof vars.labelB === \"string\" && vars.labelB ? vars.labelB : \"RIDGE\";\n        var labelC = typeof vars.labelC === \"string\" && vars.labelC ? vars.labelC : \"FORD\";\n\n        document.getElementById(\"mst-title\").textContent = title;\n        document.getElementById(\"mst-subtitle\").textContent = subtitle;\n        document.getElementById(\"mst-t1\").textContent = labelA;\n        document.getElementById(\"mst-t2\").textContent = labelB;\n        document.getElementById(\"mst-t3\").textContent = labelC;\n        [\"mst-stamp1\", \"mst-stamp2\", \"mst-stamp3\"].forEach(function (id) {\n          var g = document.getElementById(id);\n          g.querySelector(\"rect\").setAttribute(\"stroke\", accent);\n          g.querySelector(\"text\").setAttribute(\"fill\", accent);\n        });\n        gsap.set([\"#mst-land\", \"#mst-island\", \"#mst-title\", \"#mst-subtitle\", \"#mst-note\"], {\n          opacity: 0,\n        });\n        gsap.set([\"#mst-stamp1\", \"#mst-stamp2\", \"#mst-stamp3\"], {\n          opacity: 0,\n          scale: 1.55,\n          rotation: -8,\n          transformOrigin: \"50% 50%\",\n        });\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mst-land\", { opacity: 1, duration: 0.5 }, 0);\n        tl.to(\"#mst-island\", { opacity: 1, duration: 0.4 }, 0.1);\n        tl.to(\"#mst-title\", { opacity: 1, duration: 0.4 }, 0.15);\n        tl.to(\"#mst-subtitle\", { opacity: 1, duration: 0.35 }, 0.35);\n        tl.to(\n          \"#mst-stamp1\",\n          { opacity: 1, scale: 1, rotation: -3, duration: 0.35, ease: \"power3.in\" },\n          1.0,\n        );\n        tl.to(\n          \"#mst-stamp2\",\n          { opacity: 1, scale: 1, rotation: 2, duration: 0.35, ease: \"power3.in\" },\n          2.0,\n        );\n        tl.to(\n          \"#mst-stamp3\",\n          { opacity: 1, scale: 1, rotation: -2, duration: 0.35, ease: \"power3.in\" },\n          3.0,\n        );\n        tl.to(\"#mst-note\", { opacity: 1, duration: 0.4 }, 4.5);\n        window.__timelines[\"map-stamp-labels\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}
