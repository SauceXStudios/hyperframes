{"html":"<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=1920, height=1080\" />\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n    <style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      body {\n        background: #1a1714;\n        overflow: hidden;\n      }\n      #root-map-territory-wipe {\n        position: relative;\n        width: 1920px;\n        height: 1080px;\n        overflow: hidden;\n        background: #1a1714;\n        font-family: Georgia, \"Times New Roman\", serif;\n      }\n      #mtw-frame {\n        position: absolute;\n        inset: 48px;\n        border: 1px solid rgba(196, 181, 154, 0.14);\n        background: #221e19;\n      }\n      #mtw-svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      #mtw-title {\n        position: absolute;\n        top: 72px;\n        left: 96px;\n        color: rgba(232, 220, 196, 0.92);\n        font-size: 42px;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n      }\n      #mtw-subtitle {\n        position: absolute;\n        top: 128px;\n        left: 96px;\n        color: rgba(196, 181, 154, 0.55);\n        font-size: 22px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n      }\n      #mtw-badge {\n        position: absolute;\n        bottom: 96px;\n        right: 120px;\n        padding: 14px 28px;\n        border: 1px solid rgba(196, 181, 154, 0.28);\n        color: rgba(232, 220, 196, 0.9);\n        font-size: 20px;\n        letter-spacing: 0.14em;\n        text-transform: uppercase;\n        background: rgba(26, 23, 20, 0.55);\n      }\n    </style>\n  </head>\n  <body>\n    <div\n      id=\"root-map-territory-wipe\"\n      data-composition-id=\"map-territory-wipe\"\n      data-start=\"0\"\n      data-duration=\"8\"\n      data-width=\"1920\"\n      data-height=\"1080\"\n    >\n      <div id=\"mtw-frame\">\n        <svg\n          id=\"mtw-svg\"\n          viewBox=\"0 0 1920 1080\"\n          xmlns=\"http://www.w3.org/2000/svg\"\n          aria-hidden=\"true\"\n        >\n          <defs>\n            <clipPath id=\"mtw-wipe-clip\">\n              <rect id=\"mtw-wipe-rect\" x=\"640\" y=\"300\" width=\"0\" height=\"480\" />\n            </clipPath>\n            <pattern\n              id=\"mtw-hatch\"\n              width=\"10\"\n              height=\"10\"\n              patternUnits=\"userSpaceOnUse\"\n              patternTransform=\"rotate(40)\"\n            >\n              <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"10\" stroke=\"rgba(196,181,154,0.07)\" stroke-width=\"1\" />\n            </pattern>\n          </defs>\n          <rect width=\"1920\" height=\"1080\" fill=\"#1f1b17\" />\n          <rect width=\"1920\" height=\"1080\" fill=\"url(#mtw-hatch)\" />\n          <path\n            id=\"mtw-land\"\n            d=\"M 280 320 C 340 220 480 180 620 210 C 760 240 820 300 900 280 C 980 260 1080 300 1180 340 C 1280 380 1360 460 1380 560 C 1400 660 1340 760 1240 820 C 1140 880 980 900 860 860 C 740 820 700 780 620 800 C 540 820 420 780 360 700 C 300 620 240 500 280 320 Z\"\n            fill=\"rgba(196,181,154,0.16)\"\n            stroke=\"rgba(196,181,154,0.4)\"\n            stroke-width=\"2\"\n          />\n          <path\n            id=\"mtw-island\"\n            d=\"M 1480 420 C 1540 400 1600 430 1610 480 C 1620 530 1580 570 1520 560 C 1460 550 1450 450 1480 420 Z\"\n            fill=\"rgba(196,181,154,0.12)\"\n            stroke=\"rgba(196,181,154,0.3)\"\n            stroke-width=\"1.5\"\n          />\n          <!-- territory under clip -->\n          <path\n            id=\"mtw-territory\"\n            d=\"M 720 380 C 860 340 980 360 1060 420 C 1140 480 1160 580 1080 640 C 1000 700 860 720 760 680 C 660 640 640 540 680 460 C 700 420 700 400 720 380 Z\"\n            fill=\"#c45c26\"\n            fill-opacity=\"0.55\"\n            stroke=\"#c45c26\"\n            stroke-width=\"2.5\"\n            clip-path=\"url(#mtw-wipe-clip)\"\n          />\n          <path\n            id=\"mtw-territory-outline\"\n            d=\"M 720 380 C 860 340 980 360 1060 420 C 1140 480 1160 580 1080 640 C 1000 700 860 720 760 680 C 660 640 640 540 680 460 C 700 420 700 400 720 380 Z\"\n            fill=\"none\"\n            stroke=\"rgba(196,181,154,0.35)\"\n            stroke-width=\"1.5\"\n            stroke-dasharray=\"6 6\"\n          />\n          <text\n            id=\"mtw-region-label\"\n            x=\"900\"\n            y=\"520\"\n            text-anchor=\"middle\"\n            fill=\"rgba(232,220,196,0.95)\"\n            font-size=\"28\"\n            font-family=\"Georgia, serif\"\n            letter-spacing=\"0.12em\"\n            opacity=\"0\"\n          >\n            REGION\n          </text>\n        </svg>\n      </div>\n      <div id=\"mtw-title\" data-var-text=\"title\">Territory Revealed</div>\n      <div id=\"mtw-subtitle\" data-var-text=\"subtitle\">Wipe fill · educational cartography</div>\n      <div id=\"mtw-badge\" data-var-text=\"regionLabel\">Region A</div>\n    </div>\n    <script>\n      (function () {\n        window.__timelines = window.__timelines || {};\n        var vars =\n          window.__hyperframes && window.__hyperframes.getVariables\n            ? window.__hyperframes.getVariables()\n            : {};\n        var accent = /^#[0-9a-fA-F]{6}$/.test(String(vars.accent || \"\"))\n          ? String(vars.accent)\n          : \"#c45c26\";\n        var title =\n          typeof vars.title === \"string\" && vars.title ? vars.title : \"Territory Revealed\";\n        var subtitle =\n          typeof vars.subtitle === \"string\" && vars.subtitle\n            ? vars.subtitle\n            : \"Wipe fill · educational cartography\";\n        var regionLabel =\n          typeof vars.regionLabel === \"string\" && vars.regionLabel ? vars.regionLabel : \"Region A\";\n\n        document.getElementById(\"mtw-title\").textContent = title;\n        document.getElementById(\"mtw-subtitle\").textContent = subtitle;\n        document.getElementById(\"mtw-badge\").textContent = regionLabel;\n        document.getElementById(\"mtw-region-label\").textContent = regionLabel.toUpperCase();\n\n        var terr = document.getElementById(\"mtw-territory\");\n        terr.setAttribute(\"fill\", accent);\n        terr.setAttribute(\"stroke\", accent);\n\n        var wipe = document.getElementById(\"mtw-wipe-rect\");\n        gsap.set(\"#mtw-title\", { opacity: 0, y: -10 });\n        gsap.set(\"#mtw-subtitle\", { opacity: 0 });\n        gsap.set(\"#mtw-badge\", { opacity: 0, y: 10 });\n        gsap.set(\"#mtw-land\", { opacity: 0 });\n        gsap.set(\"#mtw-island\", { opacity: 0 });\n        gsap.set(\"#mtw-territory-outline\", { opacity: 0 });\n        gsap.set(\"#mtw-region-label\", { opacity: 0 });\n        gsap.set(wipe, { attr: { width: 0 } });\n\n        var tl = gsap.timeline({ paused: true });\n        tl.to(\"#mtw-land\", { opacity: 1, duration: 0.5, ease: \"power2.out\" }, 0);\n        tl.to(\"#mtw-island\", { opacity: 1, duration: 0.4, ease: \"power2.out\" }, 0.12);\n        tl.to(\"#mtw-title\", { opacity: 1, y: 0, duration: 0.45, ease: \"power2.out\" }, 0.08);\n        tl.to(\"#mtw-subtitle\", { opacity: 1, duration: 0.35, ease: \"power1.out\" }, 0.3);\n        tl.to(\"#mtw-territory-outline\", { opacity: 1, duration: 0.4, ease: \"power1.out\" }, 0.7);\n        // Horizontal wipe reveal via clip rect width\n        tl.to(wipe, { attr: { width: 560 }, duration: 2.6, ease: \"power2.inOut\" }, 1.2);\n        tl.to(\"#mtw-region-label\", { opacity: 1, duration: 0.4, ease: \"power1.out\" }, 3.5);\n        tl.to(\"#mtw-badge\", { opacity: 1, y: 0, duration: 0.45, ease: \"power2.out\" }, 3.7);\n        // Soft pulse settle on territory opacity\n        tl.to(terr, { fillOpacity: 0.7, duration: 0.6, ease: \"sine.inOut\" }, 4.2);\n        tl.to(terr, { fillOpacity: 0.55, duration: 0.6, ease: \"sine.inOut\" }, 4.8);\n\n        window.__timelines[\"map-territory-wipe\"] = tl;\n      })();\n    </script>\n  </body>\n</html>\n"}